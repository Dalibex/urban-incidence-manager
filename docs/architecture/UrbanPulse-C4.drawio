        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_ui.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · REACT / MAPLIBRE GL JS (REACT-MAP-GL) · ADR-0016&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Dense incident lists, management forms and the incident map over the self-hosted base map.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="FrontendWeb_Components.urbanpulse.frontend_web.web_ui"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_state" value="State Manager (Server State)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="320" y="703" width="260" height="106" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_state.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · REACT QUERY&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Client-side cache, retries, and invalidation of incidents and evidences.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="FrontendWeb_Components.urbanpulse.frontend_web.web_state"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="Shared Packages (Monorepo)" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0007-client-application-architecture.md" id="FrontendWeb_Components.urbanpulse.frontend_web.web_shared"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="320" y="923" width="260" height="166" as="geometry" /></mxCell></UserObject>
        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_shared.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · TYPESCRIPT (PNPM WORKSPACES) · ADR-0007&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;packages/domain (entities, enums, business rules, validation schemas), packages/api-client (typed HTTP client generated from OpenAPI, token refresh) and packages/ui, shared with the mobile app.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="FrontendWeb_Components.urbanpulse.frontend_web.web_shared"><mxGeometry x="0" y="28" width="260" height="138" as="geometry" /></mxCell>
        <UserObject label="Reverse Proxy / Web Server" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0017-reverse-proxy.md" id="FrontendWeb_Components.urbanpulse.nginx"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="415" y="1178" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="FrontendWeb_Components.urbanpulse.nginx.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · NGINX · ADR-0017&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Single published entry point in production: serves the web build and the base map tiles (/tiles/) and proxies /api to the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="FrontendWeb_Components.urbanpulse.nginx"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
