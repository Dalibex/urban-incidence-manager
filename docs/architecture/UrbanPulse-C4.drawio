Left=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="2 ·-e8"><mxGeometry y="28" width="230" height="80" as="geometry"/></mxCell><mxCell id="2 ·-e10" value="Administrator" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7B52A6;swimlaneFillColor=#FFFFFF;strokeColor=#7B52A6;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="230" height="108" as="geometry"/></mxCell><mxCell id="2 ·-b11" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Manages users, roles, categories, departments and data sources.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="2 ·-e10"><mxGeometry y="28" width="230" height="80" as="geometry"/></mxCell><mxCell id="2 ·-e12" value="Technician" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7B52A6;swimlaneFillColor=#FFFFFF;strokeColor=#7B52A6;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="230" height="108" as="geometry"/></mxCell><mxCell id="2 ·-b13" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Handles assigned work, updates its progress and documents the resolution.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="2 ·-e12"><mxGeometry y="28" width="230" height="80" as="geometry"/></mxCell><mxCell id="2 ·-e14" value="Citizen" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7B52A6;swimlaneFillColor=#FFFFFF;strokeColor=#7B52A6;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="230" height="108" as="geometry"/></mxCell><mxCell id="2 ·-b15" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Reports incidents with location and evidence, follows their status and receives notifications.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="2 ·-e14"><mxGeometry y="28" width="230" height="80" as="geometry"/></mxCell><UserObject label="OpenStreetMap" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0002-open-street-map.md" id="2 ·-e16"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6B7280;swimlaneFillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="250" height="128" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b17" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · ADR-0002&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Geocoding and reverse geocoding (Nominatim) and map features and urban assets (Overpass). Called only by the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="2 ·-e16"><mxGeometry y="28" width="250" height="100" as="geometry"/></mxCell><UserObject label="Open Data Málaga" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0009-urban-data-source.md" id="2 ·-e18"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6B7280;swimlaneFillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1170" y="100" width="250" height="128" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b19" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · ADR-0009&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Primary source of districts, neighborhoods and urban facilities (datos.malaga.eu).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="2 ·-e18"><mxGeometry y="28" width="250" height="100" as="geometry"/></mxCell><UserObject label="Open-Meteo" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0018-weather-and-traffic-providers.md" id="2 ·-e20"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6B7280;swimlaneFillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 3;opacity=80;" vertex="1" parent="1"><mxGeometry x="1440" y="100" width="250" height="128" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b21" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · PROPOSED · ADR-0018&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Current weather by coordinates (WMO weather code, wind, precipitation). No API key.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;opacity=80;" vertex="1" parent="2 ·-e20"><mxGeometry y="28" width="250" height="100" as="geometry"/></mxCell><UserObject label="TomTom Traffic" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0018-weather-and-traffic-providers.md" id="2 ·-e22"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6B7280;swimlaneFillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 3;opacity=80;" vertex="1" parent="1"><mxGeometry x="1710" y="100" width="250" height="128" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b23" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · PROPOSED · ADR-0018&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Traffic Flow Segment Data: current and free-flow speed of the road nearest to a point.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;opacity=80;" vertex="1" parent="2 ·-e22"><mxGeometry y="28" width="250" height="100" as="geometry"/></mxCell><mxCell id="2 ·-e24" value="LLM Provider" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#9CA3AF;swimlaneFillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=1 3;strokeWidth=1.5;opacity=70;" vertex="1" parent="1"><mxGeometry x="1980" y="100" width="250" height="128" as="geometry"/></mxCell><mxCell id="2 ·-b25" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · FUTURE&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;External model for classification, summarization, and RAG (to be decided; no module yet).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;opacity=70;" vertex="1" parent="2 ·-e24"><mxGeometry y="28" width="250" height="100" as="geometry"/></mxCell><mxCell id="2 ·-g26" value="UrbanPulse  [Software system]" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=1;dashed=1;dashPattern=6 4;startSize=30;fillColor=#EDF4FC;swimlaneFillColor=#EDF4FC;strokeColor=#8DB0DB;fontColor=#5B87C2;fontFamily=Helvetica;fontSize=15;fontStyle=1;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="440" y="300" width="1520" height="820" as="geometry"/></mxCell><UserObject label="Web Frontend" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0006-frontend-web-technology.md" id="2 ·-e27"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563EB;swimlaneFillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="480" y="360" width="300" height="230" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b28" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REACT + VITE + TYPESCRIPT · ADR-0006&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;SPA for operators, technicians, administrators and analysts: maps, dense incident lists and dashboards. Built with Vite and served by nginx.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="2 ·-e27"><mxGeometry y="28" width="300" height="202" as="geometry"/></mxCell><UserObject label="Mobile Frontend" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0005-mobile-application-technology.md" id="2 ·-e29"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563EB;swimlaneFillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="480" y="880" width="300" height="130" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b30" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REACT NATIVE + EXPO (EAS) · ADR-0005&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;App for citizens to report and follow incidents and for technicians' field work.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="2 ·-e29"><mxGeometry y="28" width="300" height="102" as="geometry"/></mxCell><UserObject label="Reverse Proxy / Web Server" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0017-reverse-proxy.md" id="2 ·-e31"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563EB;swimlaneFillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 3;opacity=80;" vertex="1" parent="1"><mxGeometry x="900" y="600" width="280" height="130" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b32" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · NGINX · PROPOSED · ADR-0017&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Single published entry point in production: serves the web build and the base map tiles (/tiles/) and proxies /api to the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;opacity=80;" vertex="1" parent="2 ·-e31"><mxGeometry y="28" width="280" height="102" as="geometry"/></mxCell><UserObject label="Tiles Builder" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0016-self-hosted-osm-base-map.md" id="2 ·-e33"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563EB;swimlaneFillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="900" y="900" width="280" height="150" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b34" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · PLANETILER (DOCKER, COMPOSE PROFILE TILES) · ADR-0016&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;One-off admin process run every 14 days: downloads the Andalucía OSM extract, clips it to Málaga and builds malaga.pmtiles (zoom 0-14).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="2 ·-e33"><mxGeometry y="28" width="280" height="122" as="geometry"/></mxCell><UserObject label="Backend API" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0008-backend.md" id="2 ·-e35"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563EB;swimlaneFillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1260" y="600" width="280" height="130" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b36" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · SPRING BOOT (JAVA) · ADR-0008&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Contract-first REST API (OpenAPI) built as a modular monolith; manages transactions and scheduled background jobs.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="2 ·-e35"><mxGeometry y="28" width="280" height="102" as="geometry"/></mxCell><UserObject label="PostgreSQL" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0001-database.md" id="2 ·-e37"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1E40AF;swimlaneFillColor=#FFFFFF;strokeColor=#1E40AF;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1660" y="360" width="260" height="170" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b38" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · POSTGRESQL 18 + POSTGIS 3.6 · ADR-0001&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Relational data with referential integrity, spatial geometry and JSONB. One schema shared by all modules, versioned with Flyway migrations.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="2 ·-e37"><mxGeometry y="28" width="260" height="142" as="geometry"/></mxCell><UserObject label="Evidence Storage" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0013-evidence-storage.md" id="2 ·-e39"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1E40AF;swimlaneFillColor=#FFFFFF;strokeColor=#1E40AF;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 3;opacity=80;" vertex="1" parent="1"><mxGeometry x="1660" y="590" width="260" height="170" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b40" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · DOCKER NAMED VOLUME (LOCALFSSTORAGE) · PROPOSED · ADR-0013&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Evidence binaries outside PostgreSQL in the evidence_data volume mounted in the backend, accessed only through StorageService with server-generated keys; S3-compatible storage later.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;opacity=80;" vertex="1" parent="2 ·-e39"><mxGeometry y="28" width="260" height="142" as="geometry"/></mxCell><UserObject label="Redis Cache" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0012-cache-redis.md" id="2 ·-e41"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#B91C1C;swimlaneFillColor=#FFFFFF;strokeColor=#B91C1C;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1660" y="880" width="260" height="170" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b42" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REDIS · ADR-0012&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Cache-aside with TTL on every entry: external responses, resolved geodata per zone, dashboard aggregates and rate-limit counters. Safe to lose.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="2 ·-e41"><mxGeometry y="28" width="260" height="142" as="geometry"/></mxCell><UserObject label="Geofabrik" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0016-self-hosted-osm-base-map.md" id="2 ·-e43"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6B7280;swimlaneFillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="900" y="1180" width="280" height="108" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b44" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · ADR-0016&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Regional OpenStreetMap extracts (Andalucía, .osm.pbf) used to build the base map.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="2 ·-e43"><mxGeometry y="28" width="280" height="80" as="geometry"/></mxCell><UserObject label="Brevo" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0019-notification-delivery-providers.md" id="2 ·-e45"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6B7280;swimlaneFillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 3;opacity=80;" vertex="1" parent="1"><mxGeometry x="1300" y="1180" width="260" height="110" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b46" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · PROPOSED · ADR-0019&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Transactional email API (EU-based provider).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;opacity=80;" vertex="1" parent="2 ·-e45"><mxGeometry y="28" width="260" height="82" as="geometry"/></mxCell><UserObject label="Twilio" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0019-notification-delivery-providers.md" id="2 ·-e47"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6B7280;swimlaneFillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 3;opacity=80;" vertex="1" parent="1"><mxGeometry x="1620" y="1180" width="260" height="110" as="geometry"/></mxCell></UserObject><mxCell id="2 ·-b48" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · PROPOSED · ADR-0019&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;SMS API (Programmable Messaging).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;opacity=80;" vertex="1" parent="2 ·-e47"><mxGeometry y="28" width="260" height="82" as="geometry"/></mxCell><mxCell id="2 ·-r49" value="Filters and reviews&lt;br&gt;incidents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;orthogonalLoop=1;jettySize=auto;strokeColor=#9C7AB8;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1043;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;labelBorderColor=none;spacing=2;" edge="1" parent="1" source="2 ·