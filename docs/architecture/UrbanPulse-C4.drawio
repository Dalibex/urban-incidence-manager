        <mxCell id="FrontendWeb_Components.subtitle" value="C4 level 3: the parts of the staff web app." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="36" width="1100" height="20" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.legend" value="&lt;font color=&quot;#7b52a6&quot;&gt;■&lt;/font&gt; person &amp;nbsp; &lt;font color=&quot;#2563eb&quot;&gt;■&lt;/font&gt; UrbanPulse &amp;nbsp;|&amp;nbsp; &lt;font color=&quot;#9C7AB8&quot;&gt;──&lt;/font&gt; user interaction &amp;nbsp; ── call &amp;nbsp;|&amp;nbsp; click a box to open its ADR" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;fontSize=12;fontColor=#475569;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="64" width="601" height="30" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.boundary.urbanpulse.frontend_web" value="Web Frontend  [Container]" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=1;dashed=1;dashPattern=6 4;startSize=30;fillColor=#EDF4FC;swimlaneFillColor=#EDF4FC;strokeColor=#8DB0DB;fontColor=#5B87C2;fontFamily=Helvetica;fontSize=15;fontStyle=1;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="296" y="280" width="308" height="833" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.operator-&gt;urbanpulse.frontend_web.web_router" value="Filters and reviews dense&lt;br&gt;incident lists" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#9C7AB8;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="FrontendWeb_Components.operator" target="FrontendWeb_Components.urbanpulse.frontend_web.web_router"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="287" y="272" /><mxPoint x="362" y="322" /></Array><mxPoint x="77" y="-16" as="offset" /></mxGeometry></mxCell>
        <mxCell id="FrontendWeb_Components.operator-&gt;urbanpulse.frontend_web.web_ui" value="Inspects evidence on maps" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#9C7AB8;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="FrontendWeb_Components.operator" target="FrontendWeb_Components.urbanpulse.frontend_web.web_ui"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="435" /><mxPoint x="309" y="505" /></Array><mxPoint x="77" y="-29" as="offset" /></mxGeometry></mxCell>
        <mxCell id="FrontendWeb_Components.analyst-&gt;urbanpulse.frontend_web.web_router" value="Views statistical&lt;br&gt;dashboards" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#9C7AB8;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="FrontendWeb_Components.analyst" target="FrontendWeb_Components.urbanpulse.frontend_web.web_router"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="444" y="317" /></Array><mxPoint x="45" y="-14" as="offset" /></mxGeometry></mxCell>
        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_router-&gt;urbanpulse.frontend_web.web_ui" value="Renders" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="FrontendWeb_Components.urbanpulse.frontend_web.web_router" target="FrontendWeb_Components.urbanpulse.frontend_web.web_ui"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="497" /></Array><mxPoint x="23" y="1" as="offset" /></mxGeometry></mxCell>
        <mxCell id="FrontendWeb_Components.admin-&gt;urbanpulse.frontend_web.web_router" value="Manages accounts and roles" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#9C7AB8;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="FrontendWeb_Components.admin" target="FrontendWeb_Components.urbanpulse.frontend_web.web_router"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="524" y="321" /></Array><mxPoint x="115" y="-14" as="offset" /></mxGeometry></mxCell>
        <mxCell id="FrontendWeb_Components.technician-&gt;urbanpulse.frontend_web.web_router" value="Consults assigned&lt;br&gt;incidents and updates&lt;br&gt;their progress" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#9C7AB8;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="FrontendWeb_Components.technician" target="FrontendWeb_Components.urbanpulse.frontend_web.web_router"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="799" y="272" /><mxPoint x="591" y="337" /></Array><mxPoint x="176" y="-32" as="offset" /></mxGeometry></mxCell>
        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_shared-&gt;urbanpulse.nginx" value="Calls /api&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS/JSON]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="FrontendWeb_Components.urbanpulse.frontend_web.web_shared" target="FrontendWeb_Components.urbanpulse.nginx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="516" y="1167" /></Array><mxPoint x="42" y="1" as="offset" /></mxGeometry></mxCell>
        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_ui-&gt;urbanpulse.nginx" value="Loads base map tiles,&lt;br&gt;style, fonts and sprites&lt;br&gt;(/tiles/)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS (PMTiles)]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="FrontendWeb_Components.urbanpulse.frontend_web.web_ui" target="FrontendWeb_Components.urbanpulse.nginx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="703" /><mxPoint x="600" y="1113" /><mxPoint x="591" y="1148" /><mxPoint x="581" y="1167" /></Array><mxPoint x="64" y="-22" as="offset" /></mxGeometry></mxCell>
