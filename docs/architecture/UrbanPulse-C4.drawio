        <mxCell id="Backend_Components.urbanpulse.backend.identity-&gt;urbanpulse.postgres" value="users, refresh_token&lt;br&gt;(hashed), audit_log&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JPA/JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.identity" target="Backend_Components.urbanpulse.postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2255" y="510" /><mxPoint x="2120" y="580" /><mxPoint x="189" y="1170" /><mxPoint x="0" y="1241" /><mxPoint x="0" y="1386" /><mxPoint x="68" y="1448" /><mxPoint x="1540" y="1570" /></Array><mxPoint x="663" y="-91" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.incidents-&gt;urbanpulse.postgres" value="Incident tables (ACID)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JPA/JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.incidents" target="Backend_Components.urbanpulse.postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3119" y="806" /><mxPoint x="3206" y="944" /><mxPoint x="3206" y="1140" /><mxPoint x="2894" y="1386" /><mxPoint x="1824" y="1559" /></Array><mxPoint x="288" y="-160" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.urbancontext-&gt;urbanpulse.postgres" value="urban_context,&lt;br&gt;external_observation,&lt;br&gt;data_source_config&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JPA/JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.urbancontext" target="Backend_Components.urbanpulse.postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2379" y="1140" /><mxPoint x="1883" y="1170" /><mxPoint x="1351" y="1241" /><mxPoint x="1351" y="1386" /><mxPoint x="1546" y="1502" /></Array><mxPoint x="-274" y="105" as="offset" /></mxGeometry></mxCell>
        <UserObject label="identity" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0004-authentication-strategy.md" id="Backend_Components.urbanpulse.backend.identity"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="2265" y="359" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.backend.identity.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SECURITY / SPRING DATA JPA · ADR-0004&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Users, roles and permissions; sign-up, login with in-memory attempt limits, short-lived JWTs, rotating hashed refresh tokens and a TOTP second factor for staff (ADR-0021); audit log.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.backend.identity"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.incidents" value="incidents" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="2415" y="610" width="260" height="166" as="geometry" /></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.incidents.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING WEB / SPRING DATA JPA&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;The incident as the central entity: reporting, location, categories, priority, lifecycle with allowed transitions, audited status history, assignments, comments and evidence metadata.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.backend.incidents"><mxGeometry x="0" y="28" width="260" height="138" as="geometry" /></mxCell>
        <UserObject label="urbancontext" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0009-urban-data-source.md" id="Backend_Components.urbanpulse.backend.urbancontext"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#3d8f3d;swimlaneFillColor=#FFFFFF;strokeColor=#3d8f3d;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="2399" y="944" width="260" height="196" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.backend.urbancontext.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SERVICE / SPRING DATA JPA · ADR-0009&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;External data: adapters for Open Data Málaga, OpenStreetMap and Open-Meteo (ADR-0018), and TomTom if ADR-0024 is accepted; loading of reference data, geocoding, and a scheduled worker that fills the weather of the pending contexts after the report, with timeouts and graceful degradation.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.backend.urbancontext"><mxGeometry x="0" y="28" width="260" height="168" as="geometry" /></mxCell>
        <UserObject label="geospatial" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0003-geospatial-data-management.md" id="Backend_Components.urbanpulse.backend.geospatial"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#0f766e;swimlaneFillColor=#FFFFFF;strokeColor=#0f766e;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="2614" y="1241" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.backend.geospatial.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SERVICE / SPRING DATA JPA / POSTGIS · ADR-0003&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Location and territory: districts, neighbourhoods, urban assets and spatial queries over local data.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.backend.geospatial"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
        <UserObject label="notifications" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0019-notification-delivery-providers.md" id="Backend_Components.urbanpulse.backend.notifications"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#c27803;swimlaneFillColor=#FFFFFF;strokeColor=#c27803;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="2099" y="967" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.backend.notifications.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SERVICE / SPRING DATA JPA · ADR-0019&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Notifications created on incident status changes and their delivery status; email (Brevo) and push (Expo push service) adapters behind one sender interface per channel.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.backend.notifications"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.analytics" value="analytics" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#475569;swimlaneFillColor=#FFFFFF;strokeColor=#475569;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="2618" y="389" width="260" height="91" as="geometry" /></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.analytics.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SERVICE&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Read-only indicators, zone analysis and reports; owns no tables.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.backend.analytics"><mxGeometry x="0" y="28" width="260" height="63" as="geometry" /></mxCell>
        <UserObject label="PostgreSQL" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0001-database.md" id="Backend_Components.urbanpulse.postgres"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1e40af;swimlaneFillColor=#FFFFFF;strokeColor=#1e40af;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1552" y="1508" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.postgres.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · POSTGRESQL 18 + POSTGIS 3.6 (POSTGIS/POSTGIS, DEBIAN) · ADR-0001&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Relational data with referential integrity, spatial geometry and JSONB. One schema shared by all modules, versioned with Flyway migrations.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.postgres"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <UserObject label="Redis Cache" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0022-redis-from-measurements.md" id="Backend_Components.urbanpulse.redis"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#b91c1c;swimlaneFillColor=#FFFFFF;strokeColor=#b91c1c;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="3294" y="1478" width="260" height="211" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.redis.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REDIS · ADR-0022&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Only when a measurement or a second backend replica asks for it (ADR-0022). Cache-aside with TTL on every entry, derived values only and safe to lose: external responses, resolved geodata per zone and dashboard aggregates. With a second backend replica it also holds the sign-in and sign-up rate-limit counters, which are not derived: losing them resets the limits.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.redis"><mxGeometry x="0" y="28" width="260" height="183" as="geometry" /></mxCell>
        <UserObject label="Reverse Proxy / Web Server" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0017-reverse-proxy.md" id="Backend_Components.urbanpulse.nginx"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="2116" y="110" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.nginx.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · NGINX · ADR-0017&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Single published entry point in production: serves the web build and the base map tiles (/tiles/) and proxies /api to the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.nginx"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
        <UserObject label="Evidence Storage" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0013-evidence-storage.md" id="Backend_Components.urbanpulse.evidence_storage"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1e40af;swimlaneFillColor=#FFFFFF;strokeColor=#1e40af;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="2926" y="967" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.evidence_storage.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · DOCKER NAMED VOLUME (LOCALFSSTORAGE) · ADR-0013&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Evidence binaries outside PostgreSQL in the evidence_data volume mounted in the backend, accessed only through StorageService with server-generated keys; S3-compatible storage later.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.evidence_storage"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <UserObject label="OpenStreetMap" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0002-open-street-map.md" id="Backend_Components.openstreet"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6b7280;swimlaneFillColor=#FFFFFF;strokeColor=#6b7280;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1791" y="1241" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.openstreet.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · ADR-0002&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Geocoding and reverse geocoding (Nominatim) and map features and urban assets (Overpass). Called only by the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.openstreet"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
        <UserObject label="Open Data Málaga" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0009-urban-data-source.md" id="Backend_Components.opendata"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6b7280;swimlaneFillColor=#FFFFFF;strokeColor=#6b7280;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="691" y="1248" width="260" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.opendata.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · ADR-0009&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Primary source of districts, neighborhoods and urban facilities (datos.malaga.eu).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.opendata"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="Open-Meteo" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0018-weather-and-traffic-providers.md" id="Backend_Components.openmeteo"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6b7280;swimlaneFillColor=#FFFFFF;strokeColor=#6b7280;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="991" y="1248" width="260" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.openmeteo.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · ADR-0018&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Current weather by coordinates (WMO weather code, wind, precipitation). No API key.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.openmeteo"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="TomTom Traffic" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0024-traffic-provider.md" id="Backend_Components.tomtom"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6b7280;swimlaneFillColor=#FFFFFF;strokeColor=#6b7280;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 4;opacity=80;" vertex="1" parent="1"><mxGeometry x="1491" y="1248" width="260" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.tomtom.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · PROPOSED · ADR-0024&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Traffic Flow Segment Data: current and free-flow speed of the road nearest to a point.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.tomtom"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="Brevo" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0019-notification-delivery-providers.md" id="Backend_Components.brevo"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6b7280;swimlaneFillColor=#FFFFFF;strokeColor=#6b7280;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 4;opacity=80;" vertex="1" parent="1"><mxGeometry x="91" y="1256" width="260" height="91" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.brevo.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · PROPOSED · ADR-0019&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Transactional email API (EU-based provider).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.brevo"><mxGeometry x="0" y="28" width="260" height="63" as="geometry" /></mxCell>
        <UserObject label="Expo push service" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0031-push-and-email-notifications.md" id="Backend_Components.expoPush"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6b7280;swimlaneFillColor=#FFFFFF;strokeColor=#6b7280;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 4;opacity=80;" vertex="1" parent="1"><mxGeometry x="391" y="1248" width="260" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.expoPush.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · PROPOSED · ADR-0031&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Push notifications to the citizen app; delivers on Android through Firebase Cloud Messaging.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.expoPush"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="FrontendWeb_Components" name="4 · Web frontend components">
