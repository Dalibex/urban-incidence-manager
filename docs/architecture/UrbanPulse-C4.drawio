mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3 ·-t3" value="UrbanPulse · Backend API components" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#0F172A;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="34" as="geometry"/></mxCell><mxCell id="3 ·-t4" value="C4 level 3 · one component per module package es.uma.urbanpulse.&amp;lt;module&amp;gt; (ADR-0010) · plain MVC, no enforced boundaries" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="36" width="900" height="20" as="geometry"/></mxCell><mxCell id="3 ·-lg5" value="modules of ADR-0010, coloured like the schema's table groups: &lt;font color='#7B52A6'&gt;&lt;b&gt;identity&lt;/b&gt;&lt;/font&gt; &lt;font color='#2563EB'&gt;&lt;b&gt;incidents&lt;/b&gt;&lt;/font&gt; &lt;font color='#3D8F3D'&gt;&lt;b&gt;urbancontext&lt;/b&gt;&lt;/font&gt; &lt;font color='#0F766E'&gt;&lt;b&gt;geospatial&lt;/b&gt;&lt;/font&gt; &lt;font color='#C27803'&gt;&lt;b&gt;notifications&lt;/b&gt;&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;font color='#475569'&gt;&lt;b&gt;analytics&lt;/b&gt;&lt;/font&gt; owns no tables &amp;nbsp;|&amp;nbsp; ── call &amp;nbsp; - - - async call &amp;nbsp;|&amp;nbsp; dashed box = proposed ADR" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;fontSize=12;fontColor=#475569;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="8" width="1300" height="34" as="geometry"/></mxCell><UserObject label="Reverse Proxy / Web Server" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0017-reverse-proxy.md" id="3 ·-e6"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563EB;swimlaneFillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 3;opacity=80;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="300" height="110" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b7" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · NGINX · PROPOSED · ADR-0017&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Single published entry point in production: serves the web build and the base map tiles (/tiles/) and proxies /api to the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;opacity=80;" vertex="1" parent="3 ·-e6"><mxGeometry y="28" width="300" height="82" as="geometry"/></mxCell><mxCell id="3 ·-g8" value="Backend API  [Container: Spring Boot (Java)]" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=1;dashed=1;dashPattern=6 4;startSize=30;fillColor=#EDF4FC;swimlaneFillColor=#EDF4FC;strokeColor=#8DB0DB;fontColor=#5B87C2;fontFamily=Helvetica;fontSize=15;fontStyle=1;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="1420" height="700" as="geometry"/></mxCell><UserObject label="notifications" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0019-notification-delivery-providers.md" id="3 ·-e9"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#C27803;swimlaneFillColor=#FFFFFF;strokeColor=#C27803;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="280" height="170" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b10" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SERVICE / SPRING DATA JPA · ADR-0019&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Notifications created on incident status changes and their delivery status; email (Brevo) and SMS (Twilio) adapters behind one sender interface per channel.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="3 ·-e9"><mxGeometry y="28" width="280" height="142" as="geometry"/></mxCell><mxCell id="3 ·-e11" value="incidents" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563EB;swimlaneFillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="860" y="400" width="280" height="170" as="geometry"/></mxCell><mxCell id="3 ·-b12" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING WEB / SPRING DATA JPA&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;The incident as the central entity: reporting, location, categories, priority, lifecycle with allowed transitions, audited status history, assignments, comments and evidence metadata.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="3 ·-e11"><mxGeometry y="28" width="280" height="142" as="geometry"/></mxCell><UserObject label="urbancontext" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0009-urban-data-source.md" id="3 ·-e13"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#3D8F3D;swimlaneFillColor=#FFFFFF;strokeColor=#3D8F3D;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1420" y="400" width="280" height="170" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b14" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SERVICE / SPRING DATA JPA · ADR-0009&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;External data: adapters for Open Data Málaga, OpenStreetMap, Open-Meteo and TomTom; loading of reference data, geocoding and asynchronous enrichment of incidents with timeouts and graceful degradation.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="3 ·-e13"><mxGeometry y="28" width="280" height="142" as="geometry"/></mxCell><UserObject label="identity" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0004-authentication-strategy.md" id="3 ·-e15"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7B52A6;swimlaneFillColor=#FFFFFF;strokeColor=#7B52A6;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="380" y="780" width="280" height="170" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b16" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SECURITY / SPRING DATA JPA · ADR-0004&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Users, roles and permissions; sign-up, login, short-lived JWTs and rotating hashed refresh tokens; Spring Security configuration applied to every request; audit log.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="3 ·-e15"><mxGeometry y="28" width="280" height="142" as="geometry"/></mxCell><mxCell id="3 ·-e17" value="analytics" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#475569;swimlaneFillColor=#FFFFFF;strokeColor=#475569;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="860" y="780" width="280" height="150" as="geometry"/></mxCell><mxCell id="3 ·-b18" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SERVICE&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Read-only indicators, zone analysis and reports; owns no tables.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="3 ·-e17"><mxGeometry y="28" width="280" height="122" as="geometry"/></mxCell><UserObject label="geospatial" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0003-geospatial-data-management.md" id="3 ·-e19"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#0F766E;swimlaneFillColor=#FFFFFF;strokeColor=#0F766E;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1420" y="780" width="280" height="150" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b20" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SERVICE / SPRING DATA JPA / POSTGIS · ADR-0003&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Location and territory: districts, neighbourhoods, urban assets and spatial queries over local data.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="3 ·-e19"><mxGeometry y="28" width="280" height="122" as="geometry"/></mxCell><UserObject label="Brevo" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0019-notification-delivery-providers.md" id="3 ·-e21"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6B7280;swimlaneFillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 3;opacity=80;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="200" height="110" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b22" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · PROPOSED · ADR-0019&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Transactional email API (EU-based provider).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;opacity=80;" vertex="1" parent="3 ·-e21"><mxGeometry y="28" width="200" height="82" as="geometry"/></mxCell><UserObject label="Twilio" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0019-notification-delivery-providers.md" id="3 ·-e23"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6B7280;swimlaneFillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 3;opacity=80;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="200" height="110" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b24" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · PROPOSED · ADR-0019&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;SMS API (Programmable Messaging).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;opacity=80;" vertex="1" parent="3 ·-e23"><mxGeometry y="28" width="200" height="82" as="geometry"/></mxCell><UserObject label="Open Data Málaga" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0009-urban-data-source.md" id="3 ·-e25"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6B7280;swimlaneFillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="2010" y="360" width="280" height="105" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b26" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · ADR-0009&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Primary source of districts, neighborhoods and urban facilities (datos.malaga.eu).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="3 ·-e25"><mxGeometry y="28" width="280" height="77" as="geometry"/></mxCell><UserObject label="OpenStreetMap" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0002-open-street-map.md" id="3 ·-e27"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6B7280;swimlaneFillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="2010" y="480" width="280" height="118" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b28" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · ADR-0002&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Geocoding and reverse geocoding (Nominatim) and map features and urban assets (Overpass). Called only by the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="3 ·-e27"><mxGeometry y="28" width="280" height="90" as="geometry"/></mxCell><UserObject label="Open-Meteo" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0018-weather-and-traffic-providers.md" id="3 ·-e29"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6B7280;swimlaneFillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 3;opacity=80;" vertex="1" parent="1"><mxGeometry x="2010" y="615" width="280" height="105" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b30" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · PROPOSED · ADR-0018&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Current weather by coordinates (WMO weather code, wind, precipitation). No API key.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;opacity=80;" vertex="1" parent="3 ·-e29"><mxGeometry y="28" width="280" height="77" as="geometry"/></mxCell><UserObject label="TomTom Traffic" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0018-weather-and-traffic-providers.md" id="3 ·-e31"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6B7280;swimlaneFillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 3;opacity=80;" vertex="1" parent="1"><mxGeometry x="2010" y="735" width="280" height="105" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b32" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · PROPOSED · ADR-0018&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Traffic Flow Segment Data: current and free-flow speed of the road nearest to a point.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;opacity=80;" vertex="1" parent="3 ·-e31"><mxGeometry y="28" width="280" height="77" as="geometry"/></mxCell><UserObject label="PostgreSQL" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0001-database.md" id="3 ·-e33"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1E40AF;swimlaneFillColor=#FFFFFF;strokeColor=#1E40AF;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="380" y="1110" width="600" height="110" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b34" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · POSTGRESQL 18 + POSTGIS 3.6 · ADR-0001&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Relational data with referential integrity, spatial geometry and JSONB. One schema shared by all modules, versioned with Flyway migrations.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="3 ·-e33"><mxGeometry y="28" width="600" height="82" as="geometry"/></mxCell><UserObject label="Evidence Storage" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0013-evidence-storage.md" id="3 ·-e35"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1E40AF;swimlaneFillColor=#FFFFFF;strokeColor=#1E40AF;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 3;opacity=80;" vertex="1" parent="1"><mxGeometry x="1020" y="1110" width="240" height="170" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b36" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · DOCKER NAMED VOLUME (LOCALFSSTORAGE) · PROPOSED · ADR-0013&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Evidence binaries outside PostgreSQL in the evidence_data volume mounted in the backend, accessed only through StorageService with server-generated keys; S3-compatible storage later.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;opacity=80;" vertex="1" parent="3 ·-e35"><mxGeometry y="28" width="240" height="142" as="geometry"/></mxCell><UserObject label="Redis Cache" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0012-cache-redis.md" id="3 ·-e37"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#B91C1C;swimlaneFillColor=#FFFFFF;strokeColor=#B91C1C;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1300" y="1110" width="280" height="150" as="geometry"/></mxCell></UserObject><mxCell id="3 ·-b38" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REDIS · ADR-0012&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Cache-aside with TTL on every entry: external responses, resolved geodata