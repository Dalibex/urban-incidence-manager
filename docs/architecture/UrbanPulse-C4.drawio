        <mxCell id="Containers.urbanpulse.backend-&gt;brevo" value="Sends notification emails&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS (REST API)]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Containers.urbanpulse.backend" target="Containers.brevo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="1187" /><mxPoint x="1884" y="1318" /><mxPoint x="1911" y="1332" /></Array><mxPoint x="113" y="102" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Containers.urbanpulse.backend-&gt;twilio" value="Sends notification SMS&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS (REST API)]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Containers.urbanpulse.backend" target="Containers.twilio"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="1333" /><mxPoint x="1884" y="1449" /><mxPoint x="1917" y="1464" /></Array><mxPoint x="122" y="175" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Containers.urbanpulse.backend-&gt;llm" value="Intelligent assistance&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#9ca3af;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;dashed=1;dashPattern=1 3;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Containers.urbanpulse.backend" target="Containers.llm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="1467" /><mxPoint x="1902" y="1579" /></Array><mxPoint x="130" y="252" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Containers.citizen" value="Citizen" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="260" height="106" as="geometry" /></mxCell>
        <mxCell id="Containers.citizen.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Reports incidents with location and evidence, follows their status and receives notifications.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.citizen"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <mxCell id="Containers.operator" value="Municipal Operator" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="0" y="270" width="260" height="91" as="geometry" /></mxCell>
        <mxCell id="Containers.operator.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Validates, rejects, classifies, prioritizes and assigns incidents.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.operator"><mxGeometry x="0" y="28" width="260" height="63" as="geometry" /></mxCell>
        <mxCell id="Containers.analyst" value="Analyst" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="0" y="401" width="260" height="91" as="geometry" /></mxCell>
        <mxCell id="Containers.analyst.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Explores indicators, territorial patterns and reports.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.analyst"><mxGeometry x="0" y="28" width="260" height="63" as="geometry" /></mxCell>
        <mxCell id="Containers.admin" value="Administrator" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="0" y="532" width="260" height="91" as="geometry" /></mxCell>
        <mxCell id="Containers.admin.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Manages users, roles, categories, departments and data sources.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.admin"><mxGeometry x="0" y="28" width="260" height="63" as="geometry" /></mxCell>
        <mxCell id="Containers.technician" value="Technician" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="0" y="663" width="260" height="91" as="geometry" /></mxCell>
        <mxCell id="Containers.technician.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Handles assigned work, updates its progress and documents the resolution.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.technician"><mxGeometry x="0" y="28" width="260" height="63" as="geometry" /></mxCell>
        <UserObject label="Web Frontend" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0006-frontend-web-technology.md" id="Containers.urbanpulse.frontend_web"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="480" y="378" width="260" height="136" as="geometry" /></mxCell></UserObject>
        <mxCell id="Containers.urbanpulse.frontend_web.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REACT + VITE + TYPESCRIPT · ADR-0006&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;SPA for operators, technicians, administrators and analysts: maps, dense incident lists and dashboards. Built with Vite and served by nginx.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.urbanpulse.frontend_web"><mxGeometry x="0" y="28" width="260" height="108" as="geometry" /></mxCell>
        <UserObject label="Mobile Frontend" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0005-mobile-application-technology.md" id="Containers.urbanpulse.frontend_mobile"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="480" y="209" width="260" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="Containers.urbanpulse.frontend_mobile.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REACT NATIVE + EXPO (EAS) · ADR-0005&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;App for citizens to report and follow incidents.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.urbanpulse.frontend_mobile"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="Backend API" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0008-backend.md" id="Containers.urbanpulse.backend"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1400" y="494" width="260" height="196" as="geometry" /></mxCell></UserObject>
        <mxCell id="Containers.urbanpulse.backend.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · SPRING BOOT (JAVA) · ADR-0008&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Contract-first REST API (OpenAPI) built as a modular monolith; manages transactions and scheduled background jobs. The dev, demo and perf Spring profiles load sample datasets through Flyway on startup; the bootstrap-admin profile runs it as a one-off process that creates the first administrator.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.urbanpulse.backend"><mxGeometry x="0" y="28" width="260" height="168" as="geometry" /></mxCell>
        <UserObject label="PostgreSQL" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0001-database.md" id="Containers.urbanpulse.postgres"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1e40af;swimlaneFillColor=#FFFFFF;strokeColor=#1e40af;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1884" y="540" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Containers.urbanpulse.postgres.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · POSTGRESQL 18 + POSTGIS 3.6 (POSTGIS/POSTGIS, DEBIAN) · ADR-0001&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Relational data with referential integrity, spatial geometry and JSONB. One schema shared by all modules, versioned with Flyway migrations.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.urbanpulse.postgres"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <UserObject label="Redis Cache" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0012-cache-redis.md" id="Containers.urbanpulse.redis"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#b91c1c;swimlaneFillColor=#FFFFFF;strokeColor=#b91c1c;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1884" y="379" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="Containers.urbanpulse.redis.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REDIS · ADR-0012&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Cache-aside with TTL on every entry: external responses, resolved geodata per zone and dashboard aggregates. Safe to lose.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.urbanpulse.redis"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
        <UserObject label="Reverse Proxy / Web Server" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0017-reverse-proxy.md" id="Containers.urbanpulse.nginx"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="940" y="457" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="Containers.urbanpulse.nginx.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · NGINX · ADR-0017&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Single published entry point in production: serves the web build and the base map tiles (/tiles/) and proxies /api to the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.urbanpulse.nginx"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
        <UserObject label="Evidence Storage" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0013-evidence-storage.md" id="Containers.urbanpulse.evidence_storage"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1e40af;swimlaneFillColor=#FFFFFF;strokeColor=#1e40af;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1884" y="188" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Containers.urbanpulse.evidence_storage.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · DOCKER NAMED VOLUME (LOCALFSSTORAGE) · ADR-0013&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Evidence binaries outside PostgreSQL in the evidence_data volume mounted in the backend, accessed only through StorageService with server-generated keys; S3-compatible storage later.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.urbanpulse.evidence_storage"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <UserObject label="Tiles Builder" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0016-self-hosted-osm-base-map.md" id="Containers.urbanpulse.tiles_builder"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="480" y="554" width="260" height="136" as="geometry" /></mxCell></UserObject>
        <mxCell id="Containers.urbanpulse.tiles_builder.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · PLANETILER (DOCKER, COMPOSE PROFILE TILES) · ADR-0016&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;One-off admin process run every 14 days: downloads the Andalucía OSM extract, clips it to Málaga and builds malaga.pmtiles (zoom 0-14).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.urbanpulse.tiles_builder"><mxGeometry x="0" y="28" width="260" height="108" as="geometry" /></mxCell>
        <UserObject label="OpenStreetMap" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0002-open-street-map.md" id="Containers.openstreet"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6b7280;swimlaneFillColor=#FFFFFF;strokeColor=#6b7280;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1884" y="739" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="Containers.openstreet.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · ADR-0002&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Geocoding and reverse geocoding (Nominatim) and map features and urban assets (Overpass). Called only by the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.openstreet"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
        <UserObject label="Geofabrik" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0016-self-hosted-osm-base-map.md" id="Containers.geofabrik"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6b7280;swimlaneFillColor=#FFFFFF;strokeColor=#6b7280;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="940" y="738" width="260" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="Containers.geofabrik.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · ADR-0016&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Regional OpenStreetMap extracts (Andalucía, .osm.pbf) used to build the base map.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.geofabrik"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="Open Data Málaga" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0009-urban-data-source.md" id="Containers.opendata"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6b7280;swimlaneFillColor=#FFFFFF;strokeColor=#6b7280;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1884" y="900" width="260" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="Containers.opendata.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · ADR-0009&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Primary source of districts, neighborhoods and urban facilities (datos.malaga.eu).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.opendata"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="Open-Meteo" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0018-weather-and-traffic-providers.md" id="Containers.openmeteo"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6b7280;swimlaneFillColor=#FFFFFF;strokeColor=#6b7280;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 4;opacity=80;" vertex="1" parent="1"><mxGeometry x="1884" y="1046" width="260" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="Containers.openmeteo.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · PROPOSED · ADR-0018&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Current weather by coordinates (WMO weather code, wind, precipitation). No API key.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.openmeteo"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="TomTom Traffic" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0018-weather-and-traffic-providers.md" id="Containers.tomtom"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6b7280;swimlaneFillColor=#FFFFFF;strokeColor=#6b7280;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;dashed=1;dashPattern=6 4;opacity=80;" vertex="1" parent="1"><mxGeometry x="1884" y="1192" width="260" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="Containers.tomtom.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · PROPOSED · ADR-0018&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Traffic Flow Segment Data: current and free-flow speed of the road nearest to a point.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Containers.tomtom"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
