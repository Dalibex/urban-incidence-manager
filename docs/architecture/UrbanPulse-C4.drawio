purple header = person &amp;nbsp; blue = UrbanPulse &amp;nbsp; dark blue = data store &amp;nbsp; grey = external system &amp;nbsp;|&amp;nbsp; &lt;font color='#9C7AB8'&gt;── user interaction&lt;/font&gt; &amp;nbsp; ── call &amp;nbsp; - - - async call &amp;nbsp;|&amp;nbsp; dashed box = proposed ADR &amp;nbsp; dotted = future &amp;nbsp;|&amp;nbsp; click a box to open its ADR" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;fontSize=12;fontColor=#475569;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="8" width="1300" height="34" as="geometry"/></mxCell><UserObject label="Backend API" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0008-backend.md" id="6 ·-e6"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563EB;swimlaneFillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="340" height="108" as="geometry"/></mxCell></UserObject><mxCell id="6 ·-b7" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · SPRING BOOT (JAVA) · ADR-0008&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Contract-first REST API (OpenAPI) built as a modular monolith; manages transactions and scheduled background jobs.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="6 ·-e6"><mxGeometry y="28" width="340" height="80" as="geometry"/></mxCell><mxCell id="6 ·-g8" value="PostgreSQL  [Container: PostgreSQL 18 + PostGIS 3.6]" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=1;dashed=1;dashPattern=6 4;startSize=30;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#A