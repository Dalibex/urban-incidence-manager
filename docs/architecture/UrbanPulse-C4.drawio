        <mxCell id="Database_Components.boundary.urbanpulse.postgres" value="PostgreSQL  [Container]" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=1;dashed=1;dashPattern=6 4;startSize=30;fillColor=#EDF4FC;swimlaneFillColor=#EDF4FC;strokeColor=#8DB0DB;fontColor=#5B87C2;fontFamily=Helvetica;fontSize=15;fontStyle=1;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="8" y="398" width="908" height="299" as="geometry" /></mxCell>
        <mxCell id="Database_Components.urbanpulse.backend-&gt;urbanpulse.postgres.db_relational" value="Each module reads and&lt;br&gt;writes its own tables;&lt;br&gt;analytics only reads&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JPA/JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Database_Components.urbanpulse.backend" target="Database_Components.urbanpulse.postgres.db_relational"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="323" y="336" /><mxPoint x="250" y="438" /></Array><mxPoint x="92" y="-11" as="offset" /></mxGeometry></mxCell>
