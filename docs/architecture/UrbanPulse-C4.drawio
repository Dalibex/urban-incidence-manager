        <mxCell id="Database_Components.urbanpulse.backend-&gt;urbanpulse.postgres.db_jsonb" value="Audit details, status data&lt;br&gt;and asset metadata&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JPA/JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Database_Components.urbanpulse.backend" target="Database_Components.urbanpulse.postgres.db_jsonb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="583" y="336" /><mxPoint x="707" y="491" /></Array><mxPoint x="60" y="-39" as="offset" /></mxGeometry></mxCell>
        <UserObject label="Backend API" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0008-backend.md" id="Database_Components.urbanpulse.backend"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="332" y="110" width="260" height="196" as="geometry" /></mxCell></UserObject>
        <mxCell id="Database_Components.urbanpulse.backend.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · SPRING BOOT (JAVA) · ADR-0008&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Contract-first REST API (OpenAPI) built as a modular monolith; manages transactions and scheduled background jobs. The dev, demo and perf Spring profiles load sample datasets through Flyway on startup; the bootstrap-admin profile runs it as a one-off process that creates the first administrator.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Database_Components.urbanpulse.backend"><mxGeometry x="0" y="28" width="260" height="168" as="geometry" /></mxCell>
        <UserObject label="Relational Schema" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0014-database-migrations-flyway.md" id="Database_Components.urbanpulse.postgres.db_relational"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="32" y="447" width="260" height="226" as="geometry" /></mxCell></UserObject>
        <mxCell id="Database_Components.urbanpulse.postgres.db_relational.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SQL TABLES · ADR-0014&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Table groups created by Flyway: identity (users, refresh_token, audit_log), incidents (incident, location, category, department, assignment, status_change, comment, attachment), urbancontext (urban_context, external_observation, data_source_config; also urban_asset and incident_asset, used by geospatial), notifications (notification).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Database_Components.urbanpulse.postgres.db_relational"><mxGeometry x="0" y="28" width="260" height="198" as="geometry" /></mxCell>
        <UserObject label="Spatial Engine (PostGIS)" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0003-geospatial-data-management.md" id="Database_Components.urbanpulse.postgres.db_postgis"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="332" y="492" width="260" height="136" as="geometry" /></mxCell></UserObject>
        <mxCell id="Database_Components.urbanpulse.postgres.db_postgis.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · POSTGIS EXTENSION · ADR-0003&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;geography(Point, 4326) in location.coordinates and urban_asset.geometry with GiST indexes; distance and containment operators.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Database_Components.urbanpulse.postgres.db_postgis"><mxGeometry x="0" y="28" width="260" height="108" as="geometry" /></mxCell>
        <mxCell id="Database_Components.urbanpulse.postgres.db_jsonb" value="JSONB Columns" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="632" y="500" width="260" height="121" as="geometry" /></mxCell>
        <mxCell id="Database_Components.urbanpulse.postgres.db_jsonb.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · JSONB&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Semi-structured fields: audit_log.details, status_change.associated_data and urban_asset.metadata.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Database_Components.urbanpulse.postgres.db_jsonb"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="Deployment_Development" name="7 · Deployment: development">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Deployment_Development.title" value="UrbanPulse · Deployment: development" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#0F172A;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1100" height="34" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.subtitle" value="The development setup: backend/docker-compose.yaml with every port on 127.0.0.1, and the Vite development server." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="36" width="1100" height="20" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.legend" value="&lt;font color=&quot;#2563eb&quot;&gt;■&lt;/font&gt; UrbanPulse &amp;nbsp; &lt;font color=&quot;#1e40af&quot;&gt;■&lt;/font&gt; data store &amp;nbsp; &lt;font color=&quot;#475569&quot;&gt;■&lt;/font&gt; infrastructure &amp;nbsp;|&amp;nbsp; ── call &amp;nbsp;|&amp;nbsp; outer boxes = where it runs [technology] &amp;nbsp; click a box to open its ADR" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;fontSize=12;fontColor=#475569;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="64" width="878" height="30" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine" value="&lt;b&gt;Developer machine&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Windows, macOS or Linux]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;A team member's computer&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=48;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="0" y="118" width="2640" height="956" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.device" value="&lt;b&gt;Phone or emulator&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Android or iOS, Expo development build]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Runs the citizen app&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=48;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="626" y="1082" width="443" height="196" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose" value="&lt;b&gt;Docker Compose&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Docker Engine]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;backend/docker-compose.yaml, project urbanpulse&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=65;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="24" y="436" width="2592" height="614" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.developer_browser" value="&lt;b&gt;Browser&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Chrome, Firefox, Edge or Safari]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Runs the staff web app&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=48;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="64" y="185" width="309" height="227" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose.postgres_service" value="&lt;b&gt;postgres&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[postgis/postgis:18-3.6]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Published on 127.0.0.1:5432&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=48;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="1848" y="785" width="308" height="241" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose.backend_service" value="&lt;b&gt;backend&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Image built from backend/Dockerfile]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Profile app, published on 127.0.0.1:8080. It can run from the IDE instead.&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=65;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="1275" y="643" width="346" height="304" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose.evidence_volume" value="&lt;b&gt;evidence_data&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Docker named volume]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Mounted in backend at /app/storage&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=48;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="1848" y="520" width="308" height="241" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose.tiles_service" value="&lt;b&gt;tiles-builder&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Image built from tiles/Dockerfile]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Profile tiles, run once with docker compose run&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=65;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="48" y="520" width="340" height="244" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose.backend_service.backend_instance-&gt;development.developer_machine.compose.postgres_service.postgres_instance" value="Reads and writes; applies&lt;br&gt;Flyway migrations on&lt;br&gt;startup&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_Development.development.developer_machine.compose.backend_service.backend_instance" target="Deployment_Development.development.developer_machine.compose.postgres_service.postgres_instance"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1860" y="901" /></Array><mxPoint x="34" y="-35" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose.backend_service.backend_instance-&gt;development.developer_machine.compose.evidence_volume.evidence_instance" value="Stores and reads evidence&lt;br&gt;binaries&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[File system (volume mount)]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_Development.development.developer_machine.compose.backend_service.backend_instance" target="Deployment_Development.development.developer_machine.compose.evidence_volume.evidence_instance"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1861" y="703" /></Array><mxPoint x="34" y="-53" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.developer_browser.web_instance-&gt;development.developer_machine.vite" value="Loads the SPA and calls&lt;br&gt;/api&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTP]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_Development.development.developer_machine.developer_browser.web_instance" target="Deployment_Development.development.developer_machine.vite"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="705" y="339" /></Array><mxPoint x="3" y="-23" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.vite-&gt;development.developer_machine.compose.backend_service.backend_instance" value="Proxies /api&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTP]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_Development.development.developer_machine.vite" target="Deployment_Development.development.developer_machine.compose.backend_service.backend_instance"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1069" y="426" /><mxPoint x="1345" y="719" /></Array><mxPoint x="-29" y="-117" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Deployment_Development.development.device-&gt;development.developer_machine.compose.backend_service" value="The mobile app calls /api&lt;br&gt;directly: the emulator at&lt;br&gt;10.0.2.2:8080; a physical&lt;br&gt;phone needs the backend&lt;br&gt;run from the IDE&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTP]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_Development.development.device" target="Deployment_Development.development.developer_machine.compose.backend_service"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1219" y="1165" /><mxPoint x="1358" y="956" /></Array><mxPoint x="-102" y="6" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose.postgres_service.postgres_instance-&gt;development.developer_machine.compose.postgres_volume" value="Stores the database files&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[Volume mount]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_Development.development.developer_machine.compose.postgres_service.postgres_instance" target="Deployment_Development.development.developer_machine.compose.postgres_volume"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2320" y="927" /></Array><mxPoint x="1" y="-13" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose.tiles_service.tiles_instance-&gt;development.developer_machine.compose.sources_volume" value="Reuses the downloads&lt;br&gt;between runs&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[Volume mount]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_Development.development.developer_machine.compose.tiles_service.tiles_instance" target="Deployment_Development.development.developer_machine.compose.sources_volume"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="452" y="703" /><mxPoint x="618" y="703" /><mxPoint x="705" y="691" /></Array><mxPoint x="2" y="-21" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose.tiles_service.tiles_instance-&gt;development.developer_machine.vite" value="Writes malaga.pmtiles to&lt;br&gt;frontend/apps/web/public/tiles&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[Bind mount]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_Development.development.developer_machine.compose.tiles_service.tiles_instance" target="Deployment_Development.development.developer_machine.vite"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="626" y="426" /><mxPoint x="706" y="396" /></Array><mxPoint x="15" y="-77" as="offset" /></mxGeometry></mxCell>
        <UserObject label="PostgreSQL" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0001-database.md" id="Deployment_Development.development.developer_machine.compose.postgres_service.postgres_instance"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1e40af;swimlaneFillColor=#FFFFFF;strokeColor=#1e40af;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1872" y="852" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Deployment_Development.development.developer_machine.compose.postgres_service.postgres_instance.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · POSTGRESQL 18 + POSTGIS 3.6 (POSTGIS/POSTGIS, DEBIAN) · ADR-0001&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Relational data with referential integrity, spatial geometry and JSONB. One schema shared by all modules, versioned with Flyway migrations.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_Development.development.developer_machine.compose.postgres_service.postgres_instance"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <UserObject label="Backend API" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0008-backend.md" id="Deployment_Development.development.developer_machine.compose.backend_service.backend_instance"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1317" y="727" width="260" height="196" as="geometry" /></mxCell></UserObject>
        <mxCell id="Deployment_Development.development.developer_machine.compose.backend_service.backend_instance.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · SPRING BOOT (JAVA) · ADR-0008&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Contract-first REST API (OpenAPI) built as a modular monolith; manages transactions and scheduled background jobs. The dev, demo and perf Spring profiles load sample datasets through Flyway on startup; the bootstrap-admin profile runs it as a one-off process that creates the first administrator.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_Development.development.developer_machine.compose.backend_service.backend_instance"><mxGeometry x="0" y="28" width="260" height="168" as="geometry" /></mxCell>
        <UserObject label="Evidence Storage" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0013-evidence-storage.md" id="Deployment_Development.development.developer_machine.compose.evidence_volume.evidence_instance"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1e40af;swimlaneFillColor=#FFFFFF;strokeColor=#1e40af;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1872" y="587" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Deployment_Development.development.developer_machine.compose.evidence_volume.evidence_instance.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · DOCKER NAMED VOLUME (LOCALFSSTORAGE) · ADR-0013&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Evidence binaries outside PostgreSQL in the evidence_data volume mounted in the backend, accessed only through StorageService with server-generated keys; S3-compatible storage later.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_Development.development.developer_machine.compose.evidence_volume.evidence_instance"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <UserObject label="Tiles Builder" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0016-self-hosted-osm-base-map.md" id="Deployment_Development.development.developer_machine.compose.tiles_service.tiles_instance"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="88" y="604" width="260" height="136" as="geometry" /></mxCell></UserObject>
        <mxCell id="Deployment_Development.development.developer_machine.compose.tiles_service.tiles_instance.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · PLANETILER (DOCKER, COMPOSE PROFILE TILES) · ADR-0016&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;One-off admin process run every 14 days: downloads the Andalucía OSM extract, clips it to Málaga and builds malaga.pmtiles (zoom 0-14).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_Development.development.developer_machine.compose.tiles_service.tiles_instance"><mxGeometry x="0" y="28" width="260" height="108" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose.postgres_volume" value="postgres-data" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#475569;swimlaneFillColor=#FFFFFF;strokeColor=#475569;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="2332" y="874" width="260" height="106" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose.postgres_volume.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;INFRASTRUCTURE NODE · DOCKER NAMED VOLUME&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Mounted in postgres at /var/lib/postgresql&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_Development.development.developer_machine.compose.postgres_volume"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose.sources_volume" value="tiles-sources" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#475569;swimlaneFillColor=#FFFFFF;strokeColor=#475569;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="717" y="619" width="260" height="106" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.compose.sources_volume.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;INFRASTRUCTURE NODE · DOCKER NAMED VOLUME&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;The OpenStreetMap downloads, reused between runs&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_Development.development.developer_machine.compose.sources_volume"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.vite" value="Vite development server" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#475569;swimlaneFillColor=#FFFFFF;strokeColor=#475569;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="717" y="276" width="260" height="136" as="geometry" /></mxCell>
        <mxCell id="Deployment_Development.development.developer_machine.vite.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;INFRASTRUCTURE NODE · VITE ON NODE.JS&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;pnpm dev:web on localhost:5173. Serves the SPA and frontend/apps/web/public/tiles, and proxies /api to the backend (API_PROXY_TARGET).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_Development.development.developer_machine.vite"><mxGeometry x="0" y="28" width="260" height="108" as="geometry" /></mxCell>
        <UserObject label="Web Frontend" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0006-frontend-web-technology.md" id="Deployment_Development.development.developer_machine.developer_browser.web_instance"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="88" y="252" width="260" height="136" as="geometry" /></mxCell></UserObject>
        <mxCell id="Deployment_Development.development.developer_machine.developer_browser.web_instance.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REACT + VITE + TYPESCRIPT · ADR-0006&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;SPA for operators, technicians, administrators and analysts: maps, dense incident lists and dashboards. Built with Vite and served by nginx.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_Development.development.developer_machine.developer_browser.web_instance"><mxGeometry x="0" y="28" width="260" height="108" as="geometry" /></mxCell>
        <UserObject label="Mobile Frontend" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0005-mobile-application-technology.md" id="Deployment_Development.development.device.mobile_instance"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="717" y="1148" width="260" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="Deployment_Development.development.device.mobile_instance.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REACT NATIVE + EXPO (EAS) · ADR-0005&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;App for citizens to report and follow incidents.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_Development.development.device.mobile_instance"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="Deployment_SingleHost" name="8 · Deployment: single host">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Deployment_SingleHost.title" value="UrbanPulse · Deployment: single host" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#0F172A;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1100" height="34" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.subtitle" value="The deployed system decided by ADR-0011 and ADR-0017, built by #134: nginx is the only published port." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="36" width="1100" height="20" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.legend" value="&lt;font color=&quot;#2563eb&quot;&gt;■&lt;/font&gt; UrbanPulse &amp;nbsp; &lt;font color=&quot;#1e40af&quot;&gt;■&lt;/font&gt; data store &amp;nbsp; &lt;font color=&quot;#475569&quot;&gt;■&lt;/font&gt; infrastructure &amp;nbsp;|&amp;nbsp; ── call &amp;nbsp;|&amp;nbsp; outer boxes = where it runs [technology] &amp;nbsp; click a box to open its ADR" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;fontSize=12;fontColor=#475569;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="64" width="878" height="30" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server" value="&lt;b&gt;Server&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Linux]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;One machine runs the whole system (ADR-0011)&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=48;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="0" y="118" width="2720" height="688" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.user_browser" value="&lt;b&gt;Browser&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Chrome, Firefox, Edge or Safari]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Runs the staff web app&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=48;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="64" y="814" width="309" height="227" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.phone" value="&lt;b&gt;Phone&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Android or iOS]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Runs the citizen app; release builds allow HTTPS only&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=65;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="64" y="1049" width="308" height="214" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server.compose" value="&lt;b&gt;Docker Compose&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Docker Engine]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;docker-compose.yaml at the repository root&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=48;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="24" y="185" width="2672" height="597" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.web_service" value="&lt;b&gt;web&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Image built from frontend/Dockerfile (unprivileged nginx)]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;The only published port, HTTP_PORT, with TLS&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=48;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="640" y="543" width="462" height="212" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.backend_service" value="&lt;b&gt;backend&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Image built from backend/Dockerfile]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Internal network only&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=48;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="1355" y="472" width="346" height="286" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.evidence_volume" value="&lt;b&gt;evidence_data&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Docker named volume]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Mounted in backend at /app/storage&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=48;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="1928" y="517" width="308" height="241" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.db_service" value="&lt;b&gt;db&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[postgis/postgis]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Internal network only&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=48;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="1928" y="252" width="308" height="241" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.tiles_service" value="&lt;b&gt;tiles-builder&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;[Image built from tiles/Dockerfile]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#64748B&quot;&gt;Run once every 14 days&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=48;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;collapsible=0;swimlaneLine=0;container=1;" vertex="1" parent="1"><mxGeometry x="48" y="531" width="340" height="227" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.web_service.nginx_instance-&gt;single_host.server.compose.backend_service.backend_instance" value="Proxies /api&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTP (internal network)]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_SingleHost.single_host.server.compose.web_service.nginx_instance" target="Deployment_SingleHost.single_host.server.compose.backend_service.backend_instance"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1386" y="643" /></Array><mxPoint x="30" y="-19" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.backend_service.backend_instance-&gt;single_host.server.compose.evidence_volume.evidence_instance" value="Stores and reads evidence&lt;br&gt;binaries&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[File system (volume mount)]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_SingleHost.single_host.server.compose.backend_service.backend_instance" target="Deployment_SingleHost.single_host.server.compose.evidence_volume.evidence_instance"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1941" y="653" /></Array><mxPoint x="34" y="-21" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.backend_service.backend_instance-&gt;single_host.server.compose.db_service.postgres_instance" value="Reads and writes; applies&lt;br&gt;Flyway migrations on&lt;br&gt;startup&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_SingleHost.single_host.server.compose.backend_service.backend_instance" target="Deployment_SingleHost.single_host.server.compose.db_service.postgres_instance"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1941" y="455" /></Array><mxPoint x="34" y="-76" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.tiles_service.tiles_instance-&gt;single_host.server.compose.web_service.nginx_instance" value="Publishes malaga.pmtiles&lt;br&gt;to the tiles volume&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[Docker named volume]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_SingleHost.single_host.server.compose.tiles_service.tiles_instance" target="Deployment_SingleHost.single_host.server.compose.web_service.nginx_instance"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="729" y="669" /></Array><mxPoint x="-30" y="-21" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.user_browser.web_instance-&gt;single_host.server.compose.web_service.nginx_instance" value="Loads the SPA, calls /api&lt;br&gt;and loads the base map&lt;br&gt;(/tiles/)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_SingleHost.single_host.user_browser.web_instance" target="Deployment_SingleHost.single_host.server.compose.web_service.nginx_instance"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="730" /></Array><mxPoint x="-31" y="-44" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.phone.mobile_instance-&gt;single_host.server.compose.web_service.nginx_instance" value="Calls /api and loads the&lt;br&gt;base map (/tiles/)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_SingleHost.single_host.phone.mobile_instance" target="Deployment_SingleHost.single_host.server.compose.web_service.nginx_instance"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="584" y="902" /><mxPoint x="786" y="738" /></Array><mxPoint x="-29" y="-53" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.db_service.postgres_instance-&gt;single_host.server.compose.postgres_volume" value="Stores the database files&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[Volume mount]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Deployment_SingleHost.single_host.server.compose.db_service.postgres_instance" target="Deployment_SingleHost.single_host.server.compose.postgres_volume"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2400" y="394" /></Array><mxPoint x="1" y="-13" as="offset" /></mxGeometry></mxCell>
        <UserObject label="Reverse Proxy / Web Server" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0017-reverse-proxy.md" id="Deployment_SingleHost.single_host.server.compose.web_service.nginx_instance"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="741" y="610" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.web_service.nginx_instance.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · NGINX · ADR-0017&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Single published entry point in production: serves the web build and the base map tiles (/tiles/) and proxies /api to the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_SingleHost.single_host.server.compose.web_service.nginx_instance"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
        <UserObject label="Backend API" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0008-backend.md" id="Deployment_SingleHost.single_host.server.compose.backend_service.backend_instance"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1397" y="538" width="260" height="196" as="geometry" /></mxCell></UserObject>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.backend_service.backend_instance.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · SPRING BOOT (JAVA) · ADR-0008&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Contract-first REST API (OpenAPI) built as a modular monolith; manages transactions and scheduled background jobs. The dev, demo and perf Spring profiles load sample datasets through Flyway on startup; the bootstrap-admin profile runs it as a one-off process that creates the first administrator.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_SingleHost.single_host.server.compose.backend_service.backend_instance"><mxGeometry x="0" y="28" width="260" height="168" as="geometry" /></mxCell>
        <UserObject label="Evidence Storage" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0013-evidence-storage.md" id="Deployment_SingleHost.single_host.server.compose.evidence_volume.evidence_instance"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1e40af;swimlaneFillColor=#FFFFFF;strokeColor=#1e40af;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1952" y="584" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.evidence_volume.evidence_instance.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · DOCKER NAMED VOLUME (LOCALFSSTORAGE) · ADR-0013&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Evidence binaries outside PostgreSQL in the evidence_data volume mounted in the backend, accessed only through StorageService with server-generated keys; S3-compatible storage later.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_SingleHost.single_host.server.compose.evidence_volume.evidence_instance"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <UserObject label="PostgreSQL" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0001-database.md" id="Deployment_SingleHost.single_host.server.compose.db_service.postgres_instance"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1e40af;swimlaneFillColor=#FFFFFF;strokeColor=#1e40af;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1952" y="319" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.db_service.postgres_instance.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · POSTGRESQL 18 + POSTGIS 3.6 (POSTGIS/POSTGIS, DEBIAN) · ADR-0001&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Relational data with referential integrity, spatial geometry and JSONB. One schema shared by all modules, versioned with Flyway migrations.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_SingleHost.single_host.server.compose.db_service.postgres_instance"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <UserObject label="Tiles Builder" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0016-self-hosted-osm-base-map.md" id="Deployment_SingleHost.single_host.server.compose.tiles_service.tiles_instance"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="88" y="598" width="260" height="136" as="geometry" /></mxCell></UserObject>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.tiles_service.tiles_instance.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · PLANETILER (DOCKER, COMPOSE PROFILE TILES) · ADR-0016&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;One-off admin process run every 14 days: downloads the Andalucía OSM extract, clips it to Málaga and builds malaga.pmtiles (zoom 0-14).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_SingleHost.single_host.server.compose.tiles_service.tiles_instance"><mxGeometry x="0" y="28" width="260" height="108" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.postgres_volume" value="postgres-data" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#475569;swimlaneFillColor=#FFFFFF;strokeColor=#475569;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="2412" y="349" width="260" height="91" as="geometry" /></mxCell>
        <mxCell id="Deployment_SingleHost.single_host.server.compose.postgres_volume.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;INFRASTRUCTURE NODE · DOCKER NAMED VOLUME&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Mounted in db at /var/lib/postgresql&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_SingleHost.single_host.server.compose.postgres_volume"><mxGeometry x="0" y="28" width="260" height="63" as="geometry" /></mxCell>
        <UserObject label="Web Frontend" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0006-frontend-web-technology.md" id="Deployment_SingleHost.single_host.user_browser.web_instance"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="88" y="881" width="260" height="136" as="geometry" /></mxCell></UserObject>
        <mxCell id="Deployment_SingleHost.single_host.user_browser.web_instance.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REACT + VITE + TYPESCRIPT · ADR-0006&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;SPA for operators, technicians, administrators and analysts: maps, dense incident lists and dashboards. Built with Vite and served by nginx.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_SingleHost.single_host.user_browser.web_instance"><mxGeometry x="0" y="28" width="260" height="108" as="geometry" /></mxCell>
        <UserObject label="Mobile Frontend" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0005-mobile-application-technology.md" id="Deployment_SingleHost.single_host.phone.mobile_instance"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="88" y="1133" width="260" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="Deployment_SingleHost.single_host.phone.mobile_instance.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REACT NATIVE + EXPO (EAS) · ADR-0005&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;App for citizens to report and follow incidents.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Deployment_SingleHost.single_host.phone.mobile_instance"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="Dynamic_SignIn" name="9 · Sign-in and refresh token rotation">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Dynamic_SignIn.title" value="UrbanPulse · Sign-in and refresh token rotation" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#0F172A;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1100" height="34" as="geometry" /></mxCell>
        <mxCell id="Dynamic_SignIn.subtitle" value="ADR-0004 for a citizen: a 15-minute access token and a refresh token stored only as a hash. Every refresh revokes the token used; presenting it again ends every session. Staff accounts add a TOTP step first (ADR-0021)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="36" width="1100" height="20" as="geometry" /></mxCell>
        <mxCell id="Dynamic_SignIn.legend" value="&lt;font color=&quot;#7b52a6&quot;&gt;■&lt;/font&gt; person &amp;nbsp; &lt;font color=&quot;#2563eb&quot;&gt;■&lt;/font&gt; UrbanPulse &amp;nbsp; &lt;font color=&quot;#7b52a6&quot;&gt;■&lt;/font&gt; module &amp;nbsp; &lt;font color=&quot;#1e40af&quot;&gt;■&lt;/font&gt; data store &amp;nbsp;|&amp;nbsp; &lt;font color=&quot;#9C7AB8&quot;&gt;──&lt;/font&gt; user interaction &amp;nbsp; ── call &amp;nbsp; - - - response &amp;nbsp; numbers = order of the steps &amp;nbsp;|&amp;nbsp; click a box to open its ADR" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;fontSize=12;fontColor=#475569;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="64" width="1067" height="30" as="geometry" /></mxCell>
        <mxCell id="Dynamic_SignIn.boundary.urbanpulse.backend" value="Backend API  [Container]" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=1;dashed=1;dashPattern=6 4;startSize=30;fillColor=#EDF4FC;swimlaneFillColor=#EDF4FC;strokeColor=#8DB0DB;fontColor=#5B87C2;fontFamily=Helvetica;fontSize=15;fontStyle=1;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="1363" y="118" width="308" height="224" as="geometry" /></mxCell>
        <mxCell id="Dynamic_SignIn.step1" value="1. Signs in with email and&lt;br&gt;password" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#9C7AB8;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_SignIn.citizen" target="Dynamic_SignIn.urbanpulse.frontend_mobile"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="243" /></Array><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_SignIn.step2" value="2. POST /api/v1/sessions&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_SignIn.urbanpulse.frontend_mobile" target="Dynamic_SignIn.urbanpulse.nginx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="752" y="138" /><mxPoint x="897" y="138" /><mxPoint x="954" y="176" /></Array><mxPoint x="7" y="-13" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_SignIn.step3" value="3. Proxies the request&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTP/JSON]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_SignIn.urbanpulse.nginx" target="Dynamic_SignIn.urbanpulse.backend.identity"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1217" y="165" /><mxPoint x="1355" y="165" /><mxPoint x="1376" y="175" /></Array><mxPoint x="2" y="-13" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_SignIn.step4" value="4. Reads the user by email&lt;br&gt;(the attempt limit and the&lt;br&gt;password check run in the&lt;br&gt;backend); stores the hash&lt;br&gt;of a new refresh token&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JPA/JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_SignIn.urbanpulse.backend.identity" target="Dynamic_SignIn.urbanpulse.postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1679" y="211" /><mxPoint x="1827" y="211" /><mxPoint x="1846" y="215" /></Array><mxPoint x="1" y="-40" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_SignIn.step5" value="5. 201: access token and&lt;br&gt;refresh token&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTP/JSON]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_SignIn.urbanpulse.backend.identity" target="Dynamic_SignIn.urbanpulse.nginx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1375" y="243" /></Array><mxPoint x="0" y="-20" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_SignIn.step6" value="6. Returns the tokens; the&lt;br&gt;app keeps them in&lt;br&gt;expo-secure-store&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_SignIn.urbanpulse.nginx" target="Dynamic_SignIn.urbanpulse.frontend_mobile"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="915" y="238" /><mxPoint x="897" y="237" /><mxPoint x="752" y="237" /></Array><mxPoint x="0" y="-27" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_SignIn.step7" value="7. A call is rejected with&lt;br&gt;401: POST&lt;br&gt;/api/v1/sessions/refresh&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_SignIn.urbanpulse.frontend_mobile" target="Dynamic_SignIn.urbanpulse.nginx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="752" y="301" /><mxPoint x="897" y="301" /><mxPoint x="915" y="294" /></Array><mxPoint x="0" y="-27" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_SignIn.step8" value="8. Proxies the request&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTP/JSON]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_SignIn.urbanpulse.nginx" target="Dynamic_SignIn.urbanpulse.backend.identity"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1217" y="280" /><mxPoint x="1355" y="280" /><mxPoint x="1375" y="275" /></Array><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_SignIn.step9" value="9. In one transaction,&lt;br&gt;with the user locked:&lt;br&gt;revokes the presented&lt;br&gt;token and stores a new&lt;br&gt;one. A token already&lt;br&gt;revoked revokes every&lt;br&gt;session of the user (401)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JPA/JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_SignIn.urbanpulse.backend.identity" target="Dynamic_SignIn.urbanpulse.postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1679" y="329" /><mxPoint x="1827" y="329" /><mxPoint x="1847" y="319" /></Array><mxPoint x="1" y="-54" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_SignIn.step10" value="10. 200: a new access&lt;br&gt;token and refresh token&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTP/JSON]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_SignIn.urbanpulse.backend.identity" target="Dynamic_SignIn.urbanpulse.nginx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1376" y="319" /><mxPoint x="1355" y="331" /><mxPoint x="1217" y="331" /></Array><mxPoint x="10" y="-21" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_SignIn.step11" value="11. Returns the new pair;&lt;br&gt;the app repeats the&lt;br&gt;rejected call&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_SignIn.urbanpulse.nginx" target="Dynamic_SignIn.urbanpulse.frontend_mobile"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="967" y="311" /><mxPoint x="897" y="365" /><mxPoint x="752" y="365" /></Array><mxPoint x="6" y="-27" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_SignIn.citizen" value="Citizen" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="0" y="190" width="260" height="106" as="geometry" /></mxCell>
        <mxCell id="Dynamic_SignIn.citizen.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Reports incidents with location and evidence, follows their status and receives notifications.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Dynamic_SignIn.citizen"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="Mobile Frontend" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0005-mobile-application-technology.md" id="Dynamic_SignIn.urbanpulse.frontend_mobile"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="462" y="190" width="260" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="Dynamic_SignIn.urbanpulse.frontend_mobile.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REACT NATIVE + EXPO (EAS) · ADR-0005&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;App for citizens to report and follow incidents.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Dynamic_SignIn.urbanpulse.frontend_mobile"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="identity" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0004-authentication-strategy.md" id="Dynamic_SignIn.urbanpulse.backend.identity"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1387" y="168" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Dynamic_SignIn.urbanpulse.backend.identity.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SECURITY / SPRING DATA JPA · ADR-0004&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Users, roles and permissions; sign-up, login with in-memory attempt limits, short-lived JWTs, rotating hashed refresh tokens and a TOTP second factor for staff (ADR-0021); audit log.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Dynamic_SignIn.urbanpulse.backend.identity"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <UserObject label="PostgreSQL" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0001-database.md" id="Dynamic_SignIn.urbanpulse.postgres"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1e40af;swimlaneFillColor=#FFFFFF;strokeColor=#1e40af;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1857" y="169" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Dynamic_SignIn.urbanpulse.postgres.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · POSTGRESQL 18 + POSTGIS 3.6 (POSTGIS/POSTGIS, DEBIAN) · ADR-0001&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Relational data with referential integrity, spatial geometry and JSONB. One schema shared by all modules, versioned with Flyway migrations.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Dynamic_SignIn.urbanpulse.postgres"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <UserObject label="Reverse Proxy / Web Server" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0017-reverse-proxy.md" id="Dynamic_SignIn.urbanpulse.nginx"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="927" y="183" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="Dynamic_SignIn.urbanpulse.nginx.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · NGINX · ADR-0017&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Single published entry point in production: serves the web build and the base map tiles (/tiles/) and proxies /api to the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Dynamic_SignIn.urbanpulse.nginx"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="Dynamic_ReportIncident" name="10 · Reporting an incident from the mobile app">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Dynamic_ReportIncident.title" value="UrbanPulse · Reporting an incident from the mobile app" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#0F172A;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1100" height="34" as="geometry" /></mxCell>
        <mxCell id="Dynamic_ReportIncident.subtitle" value="RF03 and RF26: the report is saved without urban context, so no external source can block it. The enrichment that follows (ADR-0009) is asynchronous, not built yet, and not shown." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="36" width="1100" height="20" as="geometry" /></mxCell>
        <mxCell id="Dynamic_ReportIncident.legend" value="&lt;font color=&quot;#7b52a6&quot;&gt;■&lt;/font&gt; person &amp;nbsp; &lt;font color=&quot;#2563eb&quot;&gt;■&lt;/font&gt; UrbanPulse &amp;nbsp; &lt;font color=&quot;#7b52a6&quot;&gt;■&lt;/font&gt; module &amp;nbsp; &lt;font color=&quot;#1e40af&quot;&gt;■&lt;/font&gt; data store &amp;nbsp;|&amp;nbsp; &lt;font color=&quot;#9C7AB8&quot;&gt;──&lt;/font&gt; user interaction &amp;nbsp; ── call &amp;nbsp; - - - response &amp;nbsp; numbers = order of the steps &amp;nbsp;|&amp;nbsp; click a box to open its ADR" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;fontSize=12;fontColor=#475569;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="64" width="1067" height="30" as="geometry" /></mxCell>
        <mxCell id="Dynamic_ReportIncident.boundary.urbanpulse.backend" value="Backend API  [Container]" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=1;dashed=1;dashPattern=6 4;startSize=30;fillColor=#EDF4FC;swimlaneFillColor=#EDF4FC;strokeColor=#8DB0DB;fontColor=#5B87C2;fontFamily=Helvetica;fontSize=15;fontStyle=1;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="1336" y="118" width="790" height="239" as="geometry" /></mxCell>
        <mxCell id="Dynamic_ReportIncident.step1" value="1. Writes a title and&lt;br&gt;description, picks an&lt;br&gt;optional category and&lt;br&gt;confirms the position" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#9C7AB8;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_ReportIncident.citizen" target="Dynamic_ReportIncident.urbanpulse.frontend_mobile"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="429" y="250" /></Array><mxPoint x="0" y="-27" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_ReportIncident.step2" value="2. POST /api/v1/incidents&lt;br&gt;with the access token&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_ReportIncident.urbanpulse.frontend_mobile" target="Dynamic_ReportIncident.urbanpulse.nginx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="731" y="244" /><mxPoint x="869" y="244" /><mxPoint x="887" y="245" /></Array><mxPoint x="0" y="-20" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_ReportIncident.step3" value="3. Proxies the request;&lt;br&gt;shared.security validates&lt;br&gt;the token&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTP/JSON]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_ReportIncident.urbanpulse.nginx" target="Dynamic_ReportIncident.urbanpulse.backend.incidents"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1349" y="250" /></Array><mxPoint x="0" y="-27" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_ReportIncident.step4" value="4. Loads the reporter" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_ReportIncident.urbanpulse.backend.incidents" target="Dynamic_ReportIncident.urbanpulse.backend.identity"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1830" y="250" /></Array><mxPoint x="0" y="-7" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_ReportIncident.step5" value="5. In one transaction: the&lt;br&gt;incident, its location and&lt;br&gt;the REPORTED status change&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JPA/JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_ReportIncident.urbanpulse.backend.incidents" target="Dynamic_ReportIncident.urbanpulse.postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1831" y="396" /></Array><mxPoint x="0" y="-57" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_ReportIncident.step6" value="6. 201: the new incident&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTP/JSON]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_ReportIncident.urbanpulse.backend.incidents" target="Dynamic_ReportIncident.urbanpulse.nginx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1349" y="282" /><mxPoint x="1328" y="287" /><mxPoint x="1189" y="287" /></Array><mxPoint x="0" y="-13" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_ReportIncident.step7" value="7. Returns the incident,&lt;br&gt;which appears in My&lt;br&gt;reports&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Dynamic_ReportIncident.urbanpulse.nginx" target="Dynamic_ReportIncident.urbanpulse.frontend_mobile"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="888" y="301" /><mxPoint x="869" y="308" /><mxPoint x="731" y="308" /></Array><mxPoint x="0" y="-27" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Dynamic_ReportIncident.citizen" value="Citizen" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="0" y="197" width="260" height="106" as="geometry" /></mxCell>
        <mxCell id="Dynamic_ReportIncident.citizen.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Reports incidents with location and evidence, follows their status and receives notifications.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Dynamic_ReportIncident.citizen"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="Mobile Frontend" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0005-mobile-application-technology.md" id="Dynamic_ReportIncident.urbanpulse.frontend_mobile"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="441" y="197" width="260" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="Dynamic_ReportIncident.urbanpulse.frontend_mobile.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REACT NATIVE + EXPO (EAS) · ADR-0005&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;App for citizens to report and follow incidents.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Dynamic_ReportIncident.urbanpulse.frontend_mobile"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="identity" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0004-authentication-strategy.md" id="Dynamic_ReportIncident.urbanpulse.backend.identity"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1842" y="175" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Dynamic_ReportIncident.urbanpulse.backend.identity.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SECURITY / SPRING DATA JPA · ADR-0004&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Users, roles and permissions; sign-up, login with in-memory attempt limits, short-lived JWTs, rotating hashed refresh tokens and a TOTP second factor for staff (ADR-0021); audit log.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Dynamic_ReportIncident.urbanpulse.backend.identity"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <mxCell id="Dynamic_ReportIncident.urbanpulse.backend.incidents" value="incidents" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1360" y="167" width="260" height="166" as="geometry" /></mxCell>
        <mxCell id="Dynamic_ReportIncident.urbanpulse.backend.incidents.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING WEB / SPRING DATA JPA&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;The incident as the central entity: reporting, location, categories, priority, lifecycle with allowed transitions, audited status history, assignments, comments and evidence metadata.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Dynamic_ReportIncident.urbanpulse.backend.incidents"><mxGeometry x="0" y="28" width="260" height="138" as="geometry" /></mxCell>
        <UserObject label="PostgreSQL" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0001-database.md" id="Dynamic_ReportIncident.urbanpulse.postgres"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1e40af;swimlaneFillColor=#FFFFFF;strokeColor=#1e40af;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1842" y="381" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Dynamic_ReportIncident.urbanpulse.postgres.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · POSTGRESQL 18 + POSTGIS 3.6 (POSTGIS/POSTGIS, DEBIAN) · ADR-0001&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Relational data with referential integrity, spatial geometry and JSONB. One schema shared by all modules, versioned with Flyway migrations.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Dynamic_ReportIncident.urbanpulse.postgres"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <UserObject label="Reverse Proxy / Web Server" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0017-reverse-proxy.md" id="Dynamic_ReportIncident.urbanpulse.nginx"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="899" y="190" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="Dynamic_ReportIncident.urbanpulse.nginx.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · NGINX · ADR-0017&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Single published entry point in production: serves the web build and the base map tiles (/tiles/) and proxies /api to the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Dynamic_ReportIncident.urbanpulse.nginx"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
