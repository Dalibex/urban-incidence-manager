        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_state-&gt;urbanpulse.frontend_web.web_shared" value="Delegates HTTP requests" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="FrontendWeb_Components.urbanpulse.frontend_web.web_state" target="FrontendWeb_Components.urbanpulse.frontend_web.web_shared"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="911" /></Array><mxPoint x="70" y="1" as="offset" /></mxGeometry></mxCell>
        <mxCell id="FrontendWeb_Components.operator" value="Municipal Operator" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="260" height="91" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.operator.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Validates, rejects, classifies, prioritizes and assigns incidents.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="FrontendWeb_Components.operator"><mxGeometry x="0" y="28" width="260" height="63" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.analyst" value="Analyst" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="260" height="91" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.analyst.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Explores indicators, territorial patterns and reports.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="FrontendWeb_Components.analyst"><mxGeometry x="0" y="28" width="260" height="63" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.admin" value="Administrator" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="260" height="91" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.admin.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Manages users, roles, categories, departments and data sources.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="FrontendWeb_Components.admin"><mxGeometry x="0" y="28" width="260" height="63" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.technician" value="Technician" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="260" height="91" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.technician.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;PERSON&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Handles assigned work, updates its progress and documents the resolution.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="FrontendWeb_Components.technician"><mxGeometry x="0" y="28" width="260" height="63" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_router" value="Router and Views" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="320" y="329" width="260" height="106" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_router.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · REACT ROUTER&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;React Router for navigation and URL-driven filters (area, date, status).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="FrontendWeb_Components.urbanpulse.frontend_web.web_router"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="UI Components and Map" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0016-self-hosted-osm-base-map.md" id="FrontendWeb_Components.urbanpulse.frontend_web.web_ui"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="320" y="508" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_ui.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · REACT / MAPLIBRE GL JS (REACT-MAP-GL) · ADR-0016&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Dense incident lists, management forms and the incident map over the self-hosted base map.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="FrontendWeb_Components.urbanpulse.frontend_web.web_ui"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_state" value="State Manager (Server State)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="320" y="703" width="260" height="106" as="geometry" /></mxCell>
        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_state.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · REACT QUERY&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Client-side cache, retries, and invalidation of incidents and evidences.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="FrontendWeb_Components.urbanpulse.frontend_web.web_state"><mxGeometry x="0" y="28" width="260" height="78" as="geometry" /></mxCell>
        <UserObject label="Shared Packages (Monorepo)" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0007-client-application-architecture.md" id="FrontendWeb_Components.urbanpulse.frontend_web.web_shared"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="320" y="923" width="260" height="166" as="geometry" /></mxCell></UserObject>
        <mxCell id="FrontendWeb_Components.urbanpulse.frontend_web.web_shared.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · TYPESCRIPT (PNPM WORKSPACES) · ADR-0007&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;packages/domain (entities, enums, business rules, validation schemas), packages/api-client (typed HTTP client generated from OpenAPI, token refresh) and packages/ui, shared with the mobile app.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="FrontendWeb_Components.urbanpulse.frontend_web.web_shared"><mxGeometry x="0" y="28" width="260" height="138" as="geometry" /></mxCell>
        <UserObject label="Reverse Proxy / Web Server" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0017-reverse-proxy.md" id="FrontendWeb_Components.urbanpulse.nginx"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="415" y="1178" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="FrontendWeb_Components.urbanpulse.nginx.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · NGINX · ADR-0017&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Single published entry point in production: serves the web build and the base map tiles (/tiles/) and proxies /api to the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="FrontendWeb_Components.urbanpulse.nginx"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
