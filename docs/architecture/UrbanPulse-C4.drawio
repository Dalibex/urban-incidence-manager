        <mxCell id="Containers.urbanpulse.frontend_web-&gt;urbanpulse.nginx" value="Loads the SPA, calls /api&lt;br&gt;and loads the base map&lt;br&gt;(/tiles/)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Containers.urbanpulse.frontend_web" target="Containers.urbanpulse.nginx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="929" y="495" /></Array><mxPoint x="0" y="-37" as="offset" /></mxGeometry></mxCell>
