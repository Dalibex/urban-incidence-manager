        <mxCell id="Backend_Components.urbanpulse.nginx-&gt;urbanpulse.backend.analytics" value="Proxies /api (reports)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTP/JSON]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.nginx" target="Backend_Components.urbanpulse.backend.analytics"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="903" y="296" /><mxPoint x="977" y="339" /></Array><mxPoint x="100" y="2" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.identity-&gt;urbanpulse.postgres" value="users, refresh_token&lt;br&gt;(hashed), audit_log&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JPA/JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.identity" target="Backend_Components.urbanpulse.postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1172" y="1347" /><mxPoint x="2219" y="1439" /></Array><mxPoint x="-416" y="-68" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.incidents-&gt;urbanpulse.postgres" value="Incident tables (ACID)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JPA/JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.incidents" target="Backend_Components.urbanpulse.postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3184" y="1040" /><mxPoint x="3418" y="1110" /><mxPoint x="3418" y="1285" /><mxPoint x="3172" y="1347" /><mxPoint x="2502" y="1434" /></Array><mxPoint x="514" y="84" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.urbancontext-&gt;urbanpulse.postgres" value="urban_context,&lt;br&gt;external_observation,&lt;br&gt;data_source_config&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JPA/JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.urbancontext" target="Backend_Components.urbanpulse.postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="1040" /><mxPoint x="1426" y="1285" /><mxPoint x="2219" y="1427" /></Array><mxPoint x="-164" y="-139" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.geospatial-&gt;urbanpulse.postgres" value="urban_asset,&lt;br&gt;incident_asset; PostGIS&lt;br&gt;spatial queries&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JPA/JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.geospatial" target="Backend_Components.urbanpulse.postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="989" y="1347" /><mxPoint x="2219" y="1441" /></Array><mxPoint x="-443" y="-66" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.notifications-&gt;urbanpulse.postgres" value="notification&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[JPA/JDBC]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.notifications" target="Backend_Components.urbanpulse.postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3077" y="1040" /><mxPoint x="3346" y="1110" /><mxPoint x="3346" y="1285" /><mxPoint x="2502" y="1428" /></Array><mxPoint x="420" y="154" as="offset" /></mxGeometry></mxCell>
        <UserObject label="identity" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0004-authentication-strategy.md" id="Backend_Components.urbanpulse.backend.identity"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#7b52a6;swimlaneFillColor=#FFFFFF;strokeColor=#7b52a6;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="902" y="1110" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.backend.identity.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SECURITY / SPRING DATA JPA · ADR-0004&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Users, roles and permissions; sign-up, login with in-memory attempt limits, short-lived JWTs, rotating hashed refresh tokens and a TOTP second factor for staff (ADR-0021); audit log.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.backend.identity"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.incidents" value="incidents" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="948" y="537" width="260" height="166" as="geometry" /></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.incidents.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING WEB / SPRING DATA JPA&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;The incident as the central entity: reporting, location, categories, priority, lifecycle with allowed transitions, audited status history, assignments, comments and evidence metadata.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.backend.incidents"><mxGeometry x="0" y="28" width="260" height="138" as="geometry" /></mxCell>
        <UserObject label="urbancontext" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0009-urban-data-source.md" id="Backend_Components.urbanpulse.backend.urbancontext"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#3d8f3d;swimlaneFillColor=#FFFFFF;strokeColor=#3d8f3d;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="958" y="844" width="260" height="166" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.backend.urbancontext.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SERVICE / SPRING DATA JPA · ADR-0009&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;External data: adapters for Open Data Málaga, OpenStreetMap, Open-Meteo and TomTom; loading of reference data, geocoding and asynchronous enrichment of incidents with timeouts and graceful degradation.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.backend.urbancontext"><mxGeometry x="0" y="28" width="260" height="138" as="geometry" /></mxCell>
        <UserObject label="geospatial" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0003-geospatial-data-management.md" id="Backend_Components.urbanpulse.backend.geospatial"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#0f766e;swimlaneFillColor=#FFFFFF;strokeColor=#0f766e;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="528" y="1125" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.backend.geospatial.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SERVICE / SPRING DATA JPA / POSTGIS · ADR-0003&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Location and territory: districts, neighbourhoods, urban assets and spatial queries over local data.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.backend.geospatial"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
        <UserObject label="notifications" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0019-notification-delivery-providers.md" id="Backend_Components.urbanpulse.backend.notifications"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#c27803;swimlaneFillColor=#FFFFFF;strokeColor=#c27803;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1258" y="851" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.backend.notifications.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SERVICE / SPRING DATA JPA · ADR-0019&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Notifications created on incident status changes and their delivery status; email (Brevo) and SMS (Twilio) adapters behind one sender interface per channel.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.backend.notifications"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.analytics" value="analytics" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#475569;swimlaneFillColor=#FFFFFF;strokeColor=#475569;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="933" y="345" width="260" height="91" as="geometry" /></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.analytics.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · SPRING SERVICE&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Read-only indicators, zone analysis and reports; owns no tables.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.backend.analytics"><mxGeometry x="0" y="28" width="260" height="63" as="geometry" /></mxCell>
        <UserObject label="PostgreSQL" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0001-database.md" id="Backend_Components.urbanpulse.postgres"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1e40af;swimlaneFillColor=#FFFFFF;strokeColor=#1e40af;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="2230" y="1377" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.postgres.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · POSTGRESQL 18 + POSTGIS 3.6 (POSTGIS/POSTGIS, DEBIAN) · ADR-0001&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Relational data with referential integrity, spatial geometry and JSONB. One schema shared by all modules, versioned with Flyway migrations.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.postgres"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <UserObject label="Redis Cache" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0012-cache-redis.md" id="Backend_Components.urbanpulse.redis"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#b91c1c;swimlaneFillColor=#FFFFFF;strokeColor=#b91c1c;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="0" y="1392" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.redis.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · REDIS · ADR-0012&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Cache-aside with TTL on every entry: external responses, resolved geodata per zone and dashboard aggregates. Safe to lose.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.redis"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
        <UserObject label="Reverse Proxy / Web Server" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0017-reverse-proxy.md" id="Backend_Components.urbanpulse.nginx"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#2563eb;swimlaneFillColor=#FFFFFF;strokeColor=#2563eb;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="421" y="110" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.nginx.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · NGINX · ADR-0017&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Single published entry point in production: serves the web build and the base map tiles (/tiles/) and proxies /api to the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.nginx"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
        <UserObject label="Evidence Storage" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0013-evidence-storage.md" id="Backend_Components.urbanpulse.evidence_storage"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1e40af;swimlaneFillColor=#FFFFFF;strokeColor=#1e40af;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="3433" y="851" width="260" height="151" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.urbanpulse.evidence_storage.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;CONTAINER · DOCKER NAMED VOLUME (LOCALFSSTORAGE) · ADR-0013&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Evidence binaries outside PostgreSQL in the evidence_data volume mounted in the backend, accessed only through StorageService with server-generated keys; S3-compatible storage later.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.urbanpulse.evidence_storage"><mxGeometry x="0" y="28" width="260" height="123" as="geometry" /></mxCell>
        <UserObject label="OpenStreetMap" link="https://github.com/Dalibex/urban-incidence-manager/blob/main/docs/adr/0002-open-street-map.md" id="Backend_Components.openstreet"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#6b7280;swimlaneFillColor=#FFFFFF;strokeColor=#6b7280;fontColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1866" y="1125" width="260" height="121" as="geometry" /></mxCell></UserObject>
        <mxCell id="Backend_Components.openstreet.body" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;EXTERNAL SYSTEM · ADR-0002&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;Geocoding and reverse geocoding (Nominatim) and map features and urban assets (Overpass). Called only by the backend.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="Backend_Components.openstreet"><mxGeometry x="0" y="28" width="260" height="93" as="geometry" /></mxCell>
