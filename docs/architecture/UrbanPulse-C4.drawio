        <mxCell id="Backend_Components.urbanpulse.backend.urbancontext-&gt;urbanpulse.redis" value="Caches external responses&lt;br&gt;(TTL), only when a&lt;br&gt;measurement asks for it&lt;br&gt;(ADR-0018, ADR-0022)" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.urbancontext" target="Backend_Components.urbanpulse.redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2708" y="1140" /><mxPoint x="3236" y="1170" /><mxPoint x="3372" y="1467" /></Array><mxPoint x="295" y="138" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.geospatial-&gt;urbanpulse.redis" value="Caches resolved geodata&lt;br&gt;per zone (TTL), only when&lt;br&gt;a measurement asks for it&lt;br&gt;(ADR-0022)" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.geospatial" target="Backend_Components.urbanpulse.redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3283" y="1524" /></Array><mxPoint x="73" y="-21" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.analytics-&gt;urbanpulse.redis" value="Caches dashboard&lt;br&gt;aggregates (TTL), only&lt;br&gt;when a measurement asks&lt;br&gt;for it (ADR-0022)" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.analytics" target="Backend_Components.urbanpulse.redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3138" y="510" /><mxPoint x="3560" y="540" /><mxPoint x="3738" y="692" /><mxPoint x="3738" y="1302" /><mxPoint x="3550" y="1470" /></Array><mxPoint x="92" y="365" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.identity-&gt;urbanpulse.redis" value="Shares the sign-in and&lt;br&gt;sign-up rate-limit&lt;br&gt;counters, only with a&lt;br&gt;second backend replica&lt;br&gt;(ADR-0022)" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.identity" target="Backend_Components.urbanpulse.redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2598" y="510" /><mxPoint x="2784" y="540" /><mxPoint x="3529" y="692" /><mxPoint x="3529" y="1302" /><mxPoint x="3467" y="1467" /></Array><mxPoint x="177" y="373" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.incidents-&gt;urbanpulse.evidence_storage" value="Stores and reads evidence&lt;br&gt;binaries through&lt;br&gt;StorageService" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.incidents" target="Backend_Components.urbanpulse.evidence_storage"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2888" y="806" /><mxPoint x="2996" y="958" /></Array><mxPoint x="159" y="58" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.urbancontext-&gt;opendata" value="Queries authoritative data&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.urbancontext" target="Backend_Components.opendata"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2379" y="1140" /><mxPoint x="1002" y="1170" /><mxPoint x="903" y="1241" /></Array><mxPoint x="-561" y="35" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.urbancontext-&gt;openstreet" value="Geocoding and asset&lt;br&gt;fallback&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.urbancontext" target="Backend_Components.openstreet"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2379" y="1140" /><mxPoint x="2065" y="1241" /><mxPoint x="2062" y="1242" /></Array><mxPoint x="109" y="2" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.urbancontext-&gt;openmeteo" value="Current weather at the&lt;br&gt;incident&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.urbancontext" target="Backend_Components.openmeteo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2379" y="1140" /><mxPoint x="1173" y="1170" /><mxPoint x="1146" y="1238" /></Array><mxPoint x="-509" y="35" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.urbancontext-&gt;tomtom" value="Traffic flow near the&lt;br&gt;incident&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.urbancontext" target="Backend_Components.tomtom"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2379" y="1140" /><mxPoint x="2048" y="1170" /><mxPoint x="1771" y="1241" /><mxPoint x="1762" y="1244" /></Array><mxPoint x="30" y="23" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.notifications-&gt;brevo" value="Sends transactional email&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS (REST API)]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.notifications" target="Backend_Components.brevo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1041" y="1140" /><mxPoint x="568" y="1170" /><mxPoint x="371" y="1241" /><mxPoint x="345" y="1251" /></Array><mxPoint x="-571" y="65" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.notifications-&gt;expoPush" value="Sends push notifications&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[HTTPS (REST API)]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.notifications" target="Backend_Components.expoPush"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="804" y="1170" /><mxPoint x="645" y="1243" /></Array><mxPoint x="-488" y="70" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.incidents-&gt;urbanpulse.backend.identity" value="Checks users and roles;&lt;br&gt;writes audit entries in&lt;br&gt;the same transaction" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.incidents" target="Backend_Components.urbanpulse.backend.identity"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2328" y="580" /><mxPoint x="2328" y="540" /><mxPoint x="2341" y="520" /></Array><mxPoint x="55" y="-25" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.incidents-&gt;urbanpulse.backend.urbancontext" value="Creates the PENDING urban&lt;br&gt;context of a new incident&lt;br&gt;in the report's&lt;br&gt;transaction; the worker&lt;br&gt;fills it afterwards, so&lt;br&gt;the report never waits&lt;br&gt;(ADR-0018)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;[Direct service call]&lt;/font&gt;" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.incidents" target="Backend_Components.urbanpulse.backend.urbancontext"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2544" y="914" /><mxPoint x="2542" y="933" /></Array><mxPoint x="77" y="-1" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.incidents-&gt;urbanpulse.backend.notifications" value="Creates notifications on&lt;br&gt;status changes" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.incidents" target="Backend_Components.urbanpulse.backend.notifications"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2245" y="806" /><mxPoint x="2235" y="955" /></Array><mxPoint x="56" y="57" as="offset" /></mxGeometry></mxCell>
        <mxCell id="Backend_Components.urbanpulse.backend.incidents-&gt;urbanpulse.backend.geospatial" value="Spatial filters on&lt;br&gt;incident locations&lt;br&gt;(radius, district)" style="edgeStyle=none;rounded=1;arcSize=20;html=1;strokeColor=#6b7280;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="Backend_Components.urbanpulse.backend.incidents" target="Backend_Components.urbanpulse.backend.geospatial"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2707" y="806" /><mxPoint x="2739" y="1230" /></Array><mxPoint x="59" y="44" as="offset" /></mxGeometry></mxCell>
