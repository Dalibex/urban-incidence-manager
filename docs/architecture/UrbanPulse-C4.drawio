ation&lt;/div&gt;&lt;div style=&quot;line-height:19px;&quot;&gt;&lt;span style=&quot;color:#64748B;font-size:10px;&quot;&gt;&lt;/span&gt;&amp;nbsp;&amp;nbsp;Foreign keys and constraints; refresh tokens stored hashed&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="6 ·-e9"><mxGeometry y="28" width="760" height="149" as="geometry"/></mxCell><UserObject label="Spatial Engine (PostGIS)" link="https://github.com/Dalibex/urban-incidence-manager/blob/boilerplate/docs/adr/0003-geospatial-data-management.md" id="6 ·-e11"><mxCell style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1E40AF;swimlaneFillColor=#FFFFFF;strokeColor=#1E40AF;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="860" y="450" width="420" height="120" as="geometry"/></mxCell></UserObject><mxCell id="6 ·-b12" value="&lt;div style=&quot;color:#64748B;font-size:10px;line-height:15px;letter-spacing:0.3px;&quot;&gt;COMPONENT · POSTGIS EXTENSION · ADR-0003&lt;/div&gt;&lt;div style=&quot;line-height:15px;&quot;&gt;geography(Point, 4326) in location.coordinates and urban_asset.geometry with GiST indexes; distance and containment operators.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacingLeft=12;spacingRight=10;spacingTop=6;connectable=0;" vertex="1" parent="6 ·-e11"><mxGeometry y="28" width="420" height="92" as="geometry"/></mxCell><mxCell id="6 ·-e13" value="JSONB Columns" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=28;fillColor=#1E40AF;swimlaneFillColor=#FFFFFF;strokeColor=#1E40AF;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;fontStyle=1;collapsible=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="1320" y="450" width="400" heig