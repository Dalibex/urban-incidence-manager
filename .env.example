# Configuration of the deployment Compose (docker-compose.yaml). Copy it to .env, which is never
# committed, and fill in the secrets: POSTGRES_PASSWORD, JWT_SECRET, MFA_ENCRYPTION_KEY and, while
# you create the first administrator, BOOTSTRAP_ADMIN_PASSWORD. Every variable is described in docs/deployment.md.
# Write the values without quotes, and leave $ and \ out of them.
#
# It holds no development value: no sample data and no published port for the database or the
# backend. Development uses backend/.env instead.

# Entry point (nginx), the only published port. Use 80 on a server.
HTTP_PORT=8000
# Public address of the base map, written into style.json by tiles-builder: the address the
# browsers and phones use to reach this machine, plus /tiles. Run tiles-builder again after
# changing it.
TILES_BASE_URL=http://localhost:8000/tiles

POSTGRES_DB=urbanpulse
POSTGRES_USER=urbanpulse
# Secret. PostgreSQL does not start without it.
POSTGRES_PASSWORD=

# Secret, at least 32 bytes: the backend does not start without it. Generate it with
# `openssl rand -base64 48` (Git Bash includes openssl).
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P14D
REFRESH_TOKEN_RETENTION=P30D

# Second factor of the staff (ADR-0021, docs/security.md). Secret: the key that encrypts the TOTP
# secrets, the Base64 of exactly 32 bytes; the backend does not start without it. Generate it with
# `openssl rand -base64 32`. Changing it makes every enrolled account unable to sign in until an
# administrator resets its second factor. MFA_REQUIRED_ROLES lists the roles asked for a code,
# separated by commas; empty, none is.
MFA_ENCRYPTION_KEY=
MFA_REQUIRED_ROLES=MUNICIPAL_OPERATOR,TECHNICIAN,ADMINISTRATOR,ANALYST
MFA_ISSUER=UrbanPulse

# Data profile (docs/datasets.md). Empty in a real deployment: no sample data. demo for the demo,
# which also needs DEMO_PASSWORD (secret, docs/demo.md).
SPRING_PROFILES_ACTIVE=
DEMO_PASSWORD=

# First administrator (docs/deployment.md, "Create the First Administrator"). Only read by its
# one-off process. The password is a secret: empty it once the account exists.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Evidence storage policy (ADR-0013). frontend/nginx.conf accepts requests up to 10 MB plus the
# multipart headers: if you raise EVIDENCE_MAX_FILE_SIZE, raise client_max_body_size there too.
# The folder of the photos is fixed in docker-compose.yaml to the evidence_data volume.
EVIDENCE_MAX_FILE_SIZE=10MB
EVIDENCE_MAX_FILES_PER_INCIDENT=5

# Weather of each incident from Open-Meteo, after the report (ADR-0018). No key: these are the
# defaults. WEATHER_ENRICHMENT_ENABLED=false stops the calls (for example without internet); the
# reports are still created and their weather stays pending. OPEN_METEO_BASE_URL must be https (http
# only on localhost), or the backend does not start.
WEATHER_ENRICHMENT_ENABLED=true
OPEN_METEO_BASE_URL=https://api.open-meteo.com
WEATHER_ENRICHMENT_INTERVAL=PT30S
WEATHER_ENRICHMENT_BATCH_SIZE=20
OPEN_METEO_TIMEOUT=PT2S
WEATHER_MAX_DELAY=PT1H
