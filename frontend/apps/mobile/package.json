{
  "name": "@urbanpulse/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "UrbanPulse mobile app for citizens (ADR-0005).",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform android --platform ios",
    "typecheck": "tsc --project tsconfig.json",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testTimeout": 20000
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@tanstack/react-query": "~5.104.5",
    "@urbanpulse/api-client": "workspace:*",
    "@urbanpulse/domain": "workspace:*",
    "@urbanpulse/ui": "workspace:*",
    "expo": "~58.0.19",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.20",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3"
  }
}
