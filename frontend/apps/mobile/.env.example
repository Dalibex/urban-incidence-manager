# Copy to .env (not versioned) and set the API the phone or emulator can reach.
# A phone cannot reach the PC as localhost: use the PC's address on the same Wi-Fi,
# for example http://192.168.1.20:8080/api/v1. The Android emulator reaches the PC at 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8080/api/v1

# Style of the base map (ADR-0016), built by the tiles-builder service and served by the web app.
# Same address rule as the API; build the tiles with TILES_BASE_URL set to http://<that address>:5173/tiles.
# Without it the report form shows a notice instead of the map: reporting then needs the GPS position.
EXPO_PUBLIC_MAP_STYLE_URL=http://192.168.1.20:5173/tiles/style.json

# Quick sign-in as the demo citizen, for the demo and development (docs/demo.md).
# Expo copies these values into the app: a build made with the flag on contains the password,
# so it is for local use and must never be distributed. Off unless set to true.
EXPO_PUBLIC_QUICK_SIGN_IN=false
# The DEMO_PASSWORD of backend/.env. Read only when EXPO_PUBLIC_QUICK_SIGN_IN=true.
EXPO_PUBLIC_DEMO_PASSWORD=
