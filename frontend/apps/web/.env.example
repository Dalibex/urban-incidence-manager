# Copy to .env (not versioned) only to change the defaults below.

# Quick sign-in as each demo user, for the demo and development (docs/demo.md).
# Vite copies these values into the bundle: a build made with the flag on contains the password,
# so it is for local use and must never be deployed. Off unless set to true.
VITE_QUICK_SIGN_IN=false
# The DEMO_PASSWORD of backend/.env. Read only when VITE_QUICK_SIGN_IN=true.
VITE_DEMO_PASSWORD=
