{
  "name": "@urbanpulse/api-client",
  "version": "0.0.1",
  "private": true,
  "description": "Typed HTTP client generated from docs/api/openapi.yml (ADR-0007, ADR-0008).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../../docs/api/openapi.yml --output src/schema.d.ts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
