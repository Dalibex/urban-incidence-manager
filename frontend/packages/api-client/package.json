{
  "name": "@urbanpulse/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed HTTP client generated from docs/api/openapi.yml (ADR-0007, ADR-0008).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../../docs/api/openapi.yml --output src/schema.d.ts",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  }
}
