# Editor settings shared by IntelliJ (built in) and VS Code (EditorConfig extension).
# They match google-java-format AOSP, so the IDE produces code that Spotless accepts.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
max_line_length = 100

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
