<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs findings excluded on purpose. Keep each exclusion narrow and say why. -->
<FindBugsFilter
		xmlns="https://github.com/spotbugs/filter/3.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

	<!-- A JPA entity keeps a reference to the managed User it points to: copying it would detach
	     it from the persistence context. The other entities only avoid the finding because their
	     Lombok setters are generated code, which SpotBugs skips. -->
	<Match>
		<Class name="es.uma.urbanpulse.identity.entity.AuditLog"/>
		<Bug pattern="EI_EXPOSE_REP2"/>
	</Match>
</FindBugsFilter>
