POSTGRES_DB=urbanpulse
POSTGRES_USER=urbanpulse
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
BACKEND_PORT=8080

# Data profile of the backend container (docs/deployment.md, docs/datasets.md). Empty: no
# sample data, as in production. dev: the shared development dataset. demo: the demo dataset
# (docs/demo.md), which also needs DEMO_PASSWORD. perf: the performance dataset.
SPRING_PROFILES_ACTIVE=

# Password of every user of the demo dataset (docs/demo.md). Required with the demo profile; without
# the profile it is not used. Write it without quotes.
DEMO_PASSWORD=

# Incidents the performance dataset generates (docs/datasets.md, "Performance Dataset"). Only
# used with the perf profile; 100000 when it is not set. Leave it commented out rather than empty.
# PERF_INCIDENTS=100000

# First administrator (docs/deployment.md, "Create the First Administrator"). Only read by the
# one-off process that creates it; the password follows the rules of sign-up (8 characters or
# more). Empty the password once the account exists. Write the values without quotes.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Access tokens (ADR-0004, docs/security.md). Required: the backend does not start without a secret
# of at least 32 bytes. Generate one with `openssl rand -base64 48` (Git Bash includes openssl).
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P14D
# Expired refresh tokens are deleted this long after they expire.
REFRESH_TOKEN_RETENTION=P30D

# Base map (ADR-0016). Only used by the tiles-builder service, which writes it into style.json.
TILES_BASE_URL=http://localhost:5173/tiles
# Evidence storage policy (ADR-0013)
STORAGE_BASE_PATH=/app/storage
EVIDENCE_MAX_FILE_SIZE=10MB
EVIDENCE_MAX_FILES_PER_INCIDENT=5
