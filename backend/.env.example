POSTGRES_DB=urbanpulse
POSTGRES_USER=urbanpulse
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
BACKEND_PORT=8080

# Data profile of the backend container (docs/development.md, "Development Dataset"). Empty: no
# sample data, as in production. dev: the shared development dataset.
SPRING_PROFILES_ACTIVE=

# Access tokens (ADR-0004, docs/security.md). Required: the backend does not start without a secret
# of at least 32 bytes. Generate one with `openssl rand -base64 48` (Git Bash includes openssl).
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P14D

# Base map (ADR-0016). Only used by the tiles-builder service, which writes it into style.json.
TILES_BASE_URL=http://localhost:5173/tiles
# Evidence storage policy (ADR-0013)
STORAGE_BASE_PATH=/app/storage
EVIDENCE_MAX_FILE_SIZE=10MB
EVIDENCE_MAX_FILES_PER_INCIDENT=5
