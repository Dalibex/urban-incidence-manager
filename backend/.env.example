POSTGRES_DB=urbanpulse
POSTGRES_USER=urbanpulse
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
BACKEND_PORT=8080

# Data profile of the backend container (docs/deployment.md, docs/datasets.md). Empty: no
# sample data, as in production. dev: the shared development dataset. demo: the demo dataset
# (docs/demo.md), which also needs DEMO_PASSWORD. perf: the performance dataset.
SPRING_PROFILES_ACTIVE=

# Password of every user of the demo dataset (docs/demo.md). Required with the demo profile; without
# the profile it is not used. Write it without quotes.
DEMO_PASSWORD=

# Incidents the performance dataset generates (docs/datasets.md, "Performance Dataset"). Only
# used with the perf profile; 100000 when it is not set. Leave it commented out rather than empty.
# PERF_INCIDENTS=100000

# First administrator (docs/deployment.md, "Create the First Administrator"). Only read by the
# one-off process that creates it; the password follows the rules of sign-up (8 characters or
# more). Empty the password once the account exists. Write the values without quotes.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Access tokens (ADR-0004, docs/security.md). Required: the backend does not start without a secret
# of at least 32 bytes. Generate one with `openssl rand -base64 48` (Git Bash includes openssl).
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P14D
# Expired refresh tokens are deleted this long after they expire.
REFRESH_TOKEN_RETENTION=P30D

# Second factor of the staff (ADR-0021, docs/security.md). Required: the key that encrypts the TOTP
# secrets, the Base64 of exactly 32 bytes; the backend does not start without it. Generate one with
# `openssl rand -base64 32`. Changing it makes every enrolled account unable to sign in until an
# administrator resets its second factor. MFA_REQUIRED_ROLES lists the roles asked for a code,
# separated by commas; empty, none is.
MFA_ENCRYPTION_KEY=
MFA_REQUIRED_ROLES=MUNICIPAL_OPERATOR,TECHNICIAN,ADMINISTRATOR,ANALYST
MFA_ISSUER=UrbanPulse

# Base map (ADR-0016). Only used by the tiles-builder service, which writes it into style.json.
TILES_BASE_URL=http://localhost:5173/tiles
# Evidence storage policy (ADR-0013). Where the backend run from the IDE or ./mvnw writes the photos,
# relative to backend/: Git ignores backend/storage/. The container of `--profile app` always uses
# its volume at /app/storage and ignores this value (docs/development.md).
STORAGE_BASE_PATH=./storage
EVIDENCE_MAX_FILE_SIZE=10MB
EVIDENCE_MAX_FILES_PER_INCIDENT=5

# Weather of each incident from Open-Meteo, after the report (ADR-0018). No key: these are the
# defaults. WEATHER_ENRICHMENT_ENABLED=false stops the calls (for example without internet); the
# reports are still created and their weather stays pending. OPEN_METEO_BASE_URL must be https (http
# only on localhost), or the backend does not start.
WEATHER_ENRICHMENT_ENABLED=true
OPEN_METEO_BASE_URL=https://api.open-meteo.com
WEATHER_ENRICHMENT_INTERVAL=PT30S
WEATHER_ENRICHMENT_BATCH_SIZE=20
OPEN_METEO_TIMEOUT=PT2S
WEATHER_MAX_DELAY=PT1H

# Normalized address of each incident from Nominatim (OpenStreetMap), after the report (#375).
# false stops the calls; the reports are still created and their address stays pending.
ADDRESS_ENRICHMENT_ENABLED=true

# Notifications to the citizen when the status of their incident changes (#373, ADR-0031): push
# through Expo and email through Brevo. Secrets: leave them empty here and set them only in your
# own .env, never committed. NOTIFICATIONS_ENABLED=false stops both scheduled jobs. A channel set
# to false only logs its rows. With push on, EXPO_ACCESS_TOKEN is required; with email on,
# BREVO_API_KEY and MAIL_FROM (the verified sender of Brevo) are required.
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
NOTIFICATIONS_EMAIL_ENABLED=false
BREVO_API_KEY=
MAIL_FROM=

# Observability of the load tests (load-tests/practice/README.md), only with `--profile observability`.
# Grafana admin password, a secret: empty, Grafana starts with admin/admin. Ports on 127.0.0.1.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
